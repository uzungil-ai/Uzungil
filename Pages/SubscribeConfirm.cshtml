@page
@model Roma.Pages.SubscribeConfirmModel

@{
    ViewData["Title"] = "Abonelik Onayı";
    var requestedAtText = Model.RequestedAt.HasValue
        ? Model.RequestedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
        : "-";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 destination-card">
            <div class="card-body">
                <h2 class="h4 mb-3">Abonelik Onayı</h2>
                <p class="mb-2">Bu abonelik talebi tarafınızdan <strong>@requestedAtText</strong> saatinde Fotografia sitesini takip edebilmeniz için iletilmiştir.</p>

                @if (Model.Success)
                {
                    <div class="alert alert-success mb-0">Onayınız alındı. Teşekkürler.</div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">Onayınız bekleniyor veya bağlantı artık geçerli değil.</div>
                }
            </div>
        </div>
    </div>
</div>
