@page "{id:int}"
@model Roma.Pages.Admin.Destinations.EditModel

<div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h2 class="h5 mb-0">Destinasyon Düzenle</h2>
            </div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Destination.Id" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Destination.Name" class="form-label">Name</label>
                        <input asp-for="Destination.Name" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Destination.Country" class="form-label">Country</label>
                        <input asp-for="Destination.Country" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Destination.Description" class="form-label">Description</label>
                        <textarea asp-for="Destination.Description" class="form-control" rows="4"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Destination.EntranceFee" class="form-label">Entrance Fee</label>
                            <input asp-for="Destination.EntranceFee" class="form-control" type="number" step="0.01" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Destination.Latitude" class="form-label">Latitude</label>
                            <input asp-for="Destination.Latitude" class="form-control" type="number" step="0.000001" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Destination.Longitude" class="form-label">Longitude</label>
                            <input asp-for="Destination.Longitude" class="form-control" type="number" step="0.000001" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="files" class="form-label">Resimler ekle (isteğe bağlı)</label>
                        <input id="files" name="files" type="file" class="form-control" multiple accept="image/*" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark">Kaydet</button>
                        <a asp-page="Index" class="btn btn-outline-dark">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
