@page
@model Roma.Pages.Admin.TestEmailModel

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h2 class="mb-4">SMTP Test E-postası</h2>

        <form method="post" class="border rounded p-4 bg-light">
            <div class="mb-3">
                <label asp-for="Input.To" class="form-label">Alıcı E-posta</label>
                <input asp-for="Input.To" class="form-control" type="email" />
            </div>

            <div class="mb-3">
                <label asp-for="Input.Subject" class="form-label">Konu</label>
                <input asp-for="Input.Subject" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Input.Body" class="form-label">Mesaj</label>
                <textarea asp-for="Input.Body" class="form-control" rows="4"></textarea>
            </div>

            <button type="submit" class="btn btn-primary w-100">Test E-postası Gönder</button>

            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="alert alert-info mt-3 mb-0">@Model.StatusMessage</div>
            }
        </form>
    </div>
</div>