@page "{id:int}"
@model Roma.Pages.PlanDetayModel
@{
    ViewData["Title"] = "Plan Detayı";
}

<div class="container mt-4">
    <h1>Plan Detayı</h1>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }
    else if (Model.Item != null)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="fw-semibold">@Model.Item.Title</div>
                <div class="small text-muted mb-2">@Model.Item.StartDate.ToString("dd.MM.yyyy") - @Model.Item.EndDate.ToString("dd.MM.yyyy")</div>
                <div class="small"><strong>Destinasyonlar:</strong> @Model.Item.DestinationsText</div>
            </div>
        </div>
    }

    <div class="mt-3 d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" href="/OpenAiSoruCevap">OpenAI-Sor</a>
        <a class="btn btn-secondary" asp-page="/Planlarim">Geri Dön</a>
    </div>
</div>