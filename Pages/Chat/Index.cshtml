@page
@model Roma.Pages.Chat.IndexModel
@{
    Layout = "_Layout";
}
<section class="chat-shell container py-3">
    <div class="chat-header d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Seyahat Asistanı</h2>
        <span class="badge text-bg-light border">AI Destekli</span>
    </div>

    <p class="text-muted mb-3">Kısa sorularla başlayın. Örn: "Roma'da 3 günde ne gezilir?"</p>

    <div class="d-flex flex-wrap gap-2 mb-3">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-prompt="Roma'da 3 günde ne gezilir?">3 günlük rota</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-prompt="Roma için günlük ortalama bütçe ne kadar?">Günlük bütçe</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-prompt="Roma'da toplu taşıma nasıl kullanılır?">Ulaşım</button>
    </div>

    <div id="chatbox" class="chat-card destination-card border-0 shadow-sm">
        <form id="chatAntiForgeryForm" method="post" class="d-none">
            @Html.AntiForgeryToken()
        </form>
        <div id="messages" class="chat-messages">
            @foreach (var message in Model.HistoryMessages)
            {
                <div class="chat-message @(message.Role == "user" ? "chat-message-user" : "chat-message-bot")">@message.Text</div>
            }
        </div>
        <div class="chat-composer input-group mt-2">
            <textarea id="userInput" class="form-control" rows="2" placeholder="Sorunuzu yazın..."></textarea>
            <button id="sendBtn" class="btn btn-primary btn-modern">Gönder</button>
        </div>
    </div>
</section>

@section Scripts{
    <script>
        var input = document.getElementById('userInput');
        var sendBtn = document.getElementById('sendBtn');
        var messagesEl = document.getElementById('messages');
        var quickPromptButtons = document.querySelectorAll('[data-prompt]');

        sendBtn.addEventListener('click', function () {
            sendMessage(input.value);
        });

        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage(input.value);
            }
        });

        quickPromptButtons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                sendMessage(btn.getAttribute('data-prompt') || '');
            });
        });

        async function sendMessage(rawText){
            var text = (rawText || '').trim();
            if(!text) return;

            var token = document.querySelector('#chatAntiForgeryForm input[name="__RequestVerificationToken"]')?.value || '';

            appendMessage('user', text);
            input.value = '';

            var res = await fetch('?handler=Ask', {
                method: 'POST',
                headers: {
                    'Content-Type':'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ text: text })
            });

            if(res.ok){
                var j = await res.json();
                appendMessage('bot', j.reply);
                if(j.redirectUrl){
                    setTimeout(function(){ window.location.href = j.redirectUrl; }, 800);
                }
            } else {
                appendMessage('bot', 'Hata: sunucuya ulaşılamadı');
            }
        }

        function appendMessage(who, text){
            var m = document.createElement('div');
            m.className = 'chat-message ' + (who === 'user' ? 'chat-message-user' : 'chat-message-bot');
            m.textContent = text;
            messagesEl.appendChild(m);
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }
    </script>
}