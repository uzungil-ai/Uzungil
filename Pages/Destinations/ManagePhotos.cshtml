@page
@model Roma.Pages.Destinations.ManagePhotosModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@{
    ViewData["Title"] = "Manage Photos";
}

<h2>Fotoğrafları Yönet - @Model.Destination?.Name</h2>

<form id="uploadForm" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="file" id="fileInput" name="Uploads" multiple />
    <button type="button" id="btnUpload">Yükle</button>
    <a asp-page="~/Admin/Destinations/Index">Geri</a>
</form>

<div id="previews" style="margin-top:12px"></div>

<h3>Mevcut Görseller</h3>
<div>
    @if (Model.Images?.Any() ?? false)
    {
        <div style="display:flex;gap:10px;flex-wrap:wrap;" id="imagesContainer">
            @foreach (var img in Model.Images.OrderBy(i => i.Order))
            {
                <div class="image-item" data-image-id="@img.Id" style="width:250px;">
                    <img src="@(Url.Content((string.IsNullOrEmpty(img.Url) ? "/" : (img.Url.StartsWith("/") ? img.Url : "/" + img.Url))))" style="width:100%;height:auto;border:1px solid #ccc;" />
                    <div style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap;">
                        <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Destination?.Id" class="delete-form" data-image-id="@img.Id">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="imageId" value="@img.Id" />
                            <button type="submit">Sil</button>
                        </form>
                       @*  <form method="get" action="/Destinations/Download" target="_blank">
                            <input type="hidden" name="destinationId" value="@Model.Destination?.Id" />
                            <input type="hidden" name="imageId" value="@img.Id" />
                            <button type="submit">İndir</button>
                        </form> *@
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>Henüz görsel yok.</p>
    }
</div>

<script>
    (function () {
        var shouldResetClientCaches = @((WebHostEnvironment.EnvironmentName == "Development").ToString().ToLowerInvariant());
        if (shouldResetClientCaches) {
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.getRegistrations()
                    .then(function (regs) { regs.forEach(function (r) { r.unregister(); }); })
                    .catch(function () { });
            }
            if ('caches' in window) {
                caches.keys()
                    .then(function (names) { return Promise.all(names.map(function (n) { return caches.delete(n); })); })
                    .catch(function () { });
            }
        }

        var fileInput = document.getElementById('fileInput');
        var previews = document.getElementById('previews');
        var btnUpload = document.getElementById('btnUpload');
        var uploadForm = document.getElementById('uploadForm');

        if (fileInput && previews) {
            fileInput.addEventListener('change', function () {
                previews.innerHTML = '';
                Array.from(fileInput.files).forEach(function (f) {
                    if (f.size > (5 * 1024 * 1024)) {
                        var p = document.createElement('div');
                        p.textContent = f.name + ' - Dosya çok büyük (max 5MB)';
                        p.style.color = 'red';
                        previews.appendChild(p);
                        return;
                    }
                    if (!f.type || !f.type.startsWith('image/')) {
                        var p2 = document.createElement('div');
                        p2.textContent = f.name + ' - Geçersiz dosya türü';
                        p2.style.color = 'red';
                        previews.appendChild(p2);
                        return;
                    }
                    var reader = new FileReader();
                    reader.onload = function (ev) {
                        var img = document.createElement('img');
                        img.src = ev.target.result;
                        img.style.maxWidth = '150px';
                        img.style.marginRight = '8px';
                        previews.appendChild(img);
                    };
                    reader.readAsDataURL(f);
                });
            });
        }

        document.querySelectorAll('.delete-form').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                if (!confirm('Bu görseli silmek istediğinize emin misiniz?')) {
                    e.preventDefault();
                }
            });
        });

        function optimizeImage(file) {
            return new Promise(function (resolve) {
                try {
                    if (!file || !file.type || !file.type.startsWith('image/')) {
                        resolve(file);
                        return;
                    }

                    // GIF animasyonunu bozmayalım.
                    if (file.type === 'image/gif') {
                        resolve(file);
                        return;
                    }

                    var objectUrl = URL.createObjectURL(file);
                    var image = new Image();
                    image.onload = function () {
                        try {
                            var maxDimension = 1920;
                            var width = image.naturalWidth || image.width;
                            var height = image.naturalHeight || image.height;

                            if (!width || !height) {
                                URL.revokeObjectURL(objectUrl);
                                resolve(file);
                                return;
                            }

                            var scale = Math.min(1, maxDimension / Math.max(width, height));
                            var targetWidth = Math.max(1, Math.round(width * scale));
                            var targetHeight = Math.max(1, Math.round(height * scale));

                            var canvas = document.createElement('canvas');
                            canvas.width = targetWidth;
                            canvas.height = targetHeight;

                            var ctx = canvas.getContext('2d');
                            if (!ctx) {
                                URL.revokeObjectURL(objectUrl);
                                resolve(file);
                                return;
                            }

                            ctx.drawImage(image, 0, 0, targetWidth, targetHeight);

                            var preferredType = 'image/webp';
                            var quality = 0.82;

                            canvas.toBlob(function (blob) {
                                URL.revokeObjectURL(objectUrl);
                                if (!blob) {
                                    resolve(file);
                                    return;
                                }

                                // Boyut avantajı yoksa orijinali gönder.
                                if (blob.size >= file.size) {
                                    resolve(file);
                                    return;
                                }

                                var ext = blob.type === 'image/webp' ? '.webp' : '.jpg';
                                var baseName = file.name.replace(/\.[^/.]+$/, '');
                                var optimized = new File([blob], baseName + ext, {
                                    type: blob.type,
                                    lastModified: Date.now()
                                });

                                resolve(optimized);
                            }, preferredType, quality);
                        } catch {
                            URL.revokeObjectURL(objectUrl);
                            resolve(file);
                        }
                    };
                    image.onerror = function () {
                        URL.revokeObjectURL(objectUrl);
                        resolve(file);
                    };
                    image.src = objectUrl;
                } catch {
                    resolve(file);
                }
            });
        }

        async function optimizeFiles(files) {
            var optimizedFiles = [];
            for (var i = 0; i < files.length; i++) {
                optimizedFiles.push(await optimizeImage(files[i]));
            }
            return optimizedFiles;
        }

        if (btnUpload && uploadForm) {
            btnUpload.addEventListener('click', async function () {
                var files = fileInput.files;
                if (!files || files.length === 0) {
                    alert('Lütfen yüklemek için dosya seçin.');
                    return;
                }

                var formData = new FormData();
                var optimizedFiles = await optimizeFiles(Array.from(files));
                optimizedFiles.forEach(function (f) { formData.append('Uploads', f); });

                var tokenInput = uploadForm.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenInput) formData.append('__RequestVerificationToken', tokenInput.value);

                btnUpload.disabled = true;
                btnUpload.textContent = 'Optimize edilip yükleniyor...';

                fetch('/api/TestUpload/@Model.Destination?.Id', {
                    method: 'POST',
                    credentials: 'same-origin',
                    body: formData
                })
                .then(function (resp) { return resp.json(); })
                .then(function (json) {
                    if (!json || !json.success) {
                        var msg = (json && json.message) ? json.message : 'Yükleme başarısız';
                        alert(msg);
                        return;
                    }
                    location.reload();
                })
                .catch(function () {
                    alert('Yükleme sırasında hata oluştu');
                })
                .finally(function () {
                    btnUpload.disabled = false;
                    btnUpload.textContent = 'Yükle (Taşıyarak)';
                });
            });
        }

        var container = document.getElementById('imagesContainer');
        if (container) {
            var dragged = null;
            container.querySelectorAll('.image-item').forEach(function (item) {
                item.draggable = true;
                item.addEventListener('dragstart', function () { dragged = item; item.style.opacity = '0.5'; });
                item.addEventListener('dragend', function () { dragged = null; item.style.opacity = ''; });
                item.addEventListener('dragover', function (e) { e.preventDefault(); });
                item.addEventListener('drop', function (e) {
                    e.preventDefault();
                    if (dragged && dragged !== item) {
                        container.insertBefore(dragged, item);
                        persistOrder();
                    }
                });
            });
        }

        function persistOrder() {
            var ids = Array.from(document.querySelectorAll('.image-item'))
                .map(function (el) { return parseInt(el.dataset.imageId); });

            fetch(window.location.pathname + '?handler=Reorder&id=@Model.Destination?.Id', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(ids)
            });
        }
    })();
</script>
