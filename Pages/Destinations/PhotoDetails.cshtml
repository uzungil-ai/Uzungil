                                        <div class="list-group-item px-0">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="small text-muted">@MaskEmail(review.User?.Email)</span>
                                                <span class="small text-muted">@review.Rating/5</span>
                                            </div>
                                            <div class="small">@review.Comment</div>
                                        </div>
                }
            </div>
                            }
                        </div>
                    </div>
                </div>
                }
            </div>
        </div>
    }




    @if (Model.Destination.Parkings?.Any() == true)
    {
        <div id="parkingsDeferredLoader" class="small text-muted mt-4 mb-2">Otopark bilgileri arka planda hazırlanıyor...</div>
        <div id="parkingsDeferredSection" class="d-none" aria-hidden="true">
            <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
                <h5 class="mb-0 details-name-align details-section-title">Otoparklar</h5>
                @if (canAdd)
                {
                    <a class="btn btn-sm btn-primary" asp-controller="Parkings" asp-action="Create" asp-route-destinationId="@Model.Destination.Id" title="Ekle">+</a>
                }
            </div>
            <div class="row g-3 mb-4 mobile-three-cards">
                @foreach (var item in Model.Destination.Parkings)
                {
                var parkingQuery = $"{item.Name} {Model.Destination.Name}";
                var parkingSearchUrl = $"https://www.google.com/search?q={Uri.EscapeDataString(parkingQuery)}";
                var parkingMapsUrl = $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(parkingQuery)}";
                var parkingAttraction = (Model.Destination.Attractions ?? new List<Roma.Models.Attraction>())
                    .FirstOrDefault(a => string.Equals(a.Name?.Trim(), item.Name?.Trim(), StringComparison.OrdinalIgnoreCase));
                var parkingApprovedReviews = parkingAttraction?.Reviews?
                    .Where(r => r.IsApproved && !r.IsRejected)
                    .OrderByDescending(r => r.CreatedAt)
                    .ToList() ?? new List<Roma.Models.Review>();
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm info-card destination-card border-0 reveal-up">
                        <div class="card-body">
                            <div class="fw-semibold mb-2 d-flex align-items-center gap-2">
                                <a href="@parkingSearchUrl" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-reset attraction-name-link card-link-hover" title="Google'da ara: @parkingQuery">@item.Name</a>
                                <a href="@parkingMapsUrl" target="_blank" rel="noopener noreferrer" class="text-decoration-none card-link-hover" title="Haritada aç: @parkingQuery" aria-label="Haritada aç: @parkingQuery">📍</a>
                            </div>
                            <div class="small text-muted">Sabit Ücret: @(item.Fee.HasValue ? $"{item.Fee.Value:0.##} TL" : "-")</div>
                            <div class="small text-muted">Saatlik Ücret: @(item.HourlyRate.HasValue ? $"{item.HourlyRate.Value:0.##} TL" : "-")</div>
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0 d-flex flex-wrap gap-2">
                            <a class="btn btn-sm btn-comment-link"
                               data-bs-toggle="collapse"
                               href="#parking-reviews-@item.Id"
                               role="button"
                               aria-expanded="false"
                               aria-controls="parking-reviews-@item.Id">Yorumlar (@parkingApprovedReviews.Count)</a>
                            @if (parkingAttraction != null)
                            {
                                <a class="btn btn-sm btn-comment-link" asp-controller="Reviews" asp-action="Create" asp-route-attractionId="@parkingAttraction.Id" asp-route-returnUrl="@currentPhotoDetailsUrl">Yorum Ekle</a>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-comment-link" asp-controller="Reviews" asp-action="Create" asp-route-returnUrl="@currentPhotoDetailsUrl">Yorum Ekle</a>
                            }
                        </div>
                        <div class="collapse mt-2 px-3 pb-3" id="parking-reviews-@item.Id">
                            @if (parkingApprovedReviews.Count == 0)
                            {
                                <div class="small text-muted">Bu otopark için henüz onaylı yorum bulunmuyor.</div>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var review in parkingApprovedReviews)
                                    {
                                        <div class="list-group-item px-0">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="small text-muted">@MaskEmail(review.User?.Email)</span>
                                                <span class="small text-muted">@review.Rating/5</span>
                                            </div>
                                            <div class="small">@review.Comment</div>
                                        </div>
                }
            </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-center gap-2 mt-4 mb-4">
        <a class="btn btn-soft-yellow-action" href="javascript:history.back()">Önceki Sayfa</a>
        <a class="btn btn-soft-yellow-action" asp-page="/Index">Ana Sayfa</a>
    </div>
}
</div>
