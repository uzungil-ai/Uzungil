            height: 100%;
        }

        .info-card {
            transition: transform .15s ease, box-shadow .15s ease;
            border: 0 !important;
            background: var(--bs-card-bg, #fff) !important;
        }

        .photo-details-page .info-card .card-footer {
            border-top: 0 !important;
        }

        .info-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .12) !important;
        }

        .mini-label {
            font-size: .72rem;
            letter-spacing: .03em;
        }

        .photo-card .photo-frame {
            aspect-ratio: 4 / 3;
            background: #f8f9fa;
            display: block;
            overflow: hidden;
