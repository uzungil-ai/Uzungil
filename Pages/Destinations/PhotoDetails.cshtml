<div class="photo-details-page">
<br />
<br />
@if (Model.Destination != null)
{
    var firstImageItem = Model.Destination.Images?.OrderBy(x => x.Order).FirstOrDefault();
    var firstImage = firstImageItem?.Url ?? string.Empty;
    var firstImageAltText = string.IsNullOrWhiteSpace(firstImageItem?.AltText)
        ? Model.Destination.Name
        : firstImageItem!.AltText!.Trim();
    var sharePageUrl = $"https://www.fotografia.com.tr/Destinations/PhotoDetails/{Model.Destination.Id}";
    var imageUrlAbsolute = string.IsNullOrWhiteSpace(firstImage)
        ? string.Empty
        : ((firstImage.StartsWith("http://") || firstImage.StartsWith("https://"))
            ? firstImage
            : $"https://www.fotografia.com.tr{firstImage}");
    var instagramUrl = string.IsNullOrWhiteSpace(Model.Destination.InstagramUrl)
        ? string.Empty
        : (Model.Destination.InstagramUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
           Model.Destination.InstagramUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            ? Model.Destination.InstagramUrl
            : $"https://{Model.Destination.InstagramUrl}");
    var facebookUrl = string.IsNullOrWhiteSpace(Model.Destination.FacebookUrl)
        ? string.Empty
        : (Model.Destination.FacebookUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
           Model.Destination.FacebookUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            ? Model.Destination.FacebookUrl
            : $"https://{Model.Destination.FacebookUrl}");
    var currentPhotoDetailsUrl = $"/Destinations/PhotoDetails/{Model.Destination.Id}";
    var destinationApprovedReviews = (Model.Destination.Attractions ?? new List<Roma.Models.Attraction>())
        .SelectMany(a => (a.Reviews ?? new List<Roma.Models.Review>())
            .Where(r => r.IsApproved && !r.IsRejected))
        .ToList();
    var destinationAverageRating = destinationApprovedReviews.Any()
        ? destinationApprovedReviews.Average(x => x.Rating)
        : 0;

    <div class="card mb-4 shadow-sm destination-card border-0 reveal-up">
        <div class="card-body">
            <h4 class="mb-3 details-section-title">@Model.Destination.Name</h4>
            <div class="row">
                <div class="col-12 details-plain-text">@Model.Destination.Description</div>
            </div>

@section Scripts {
    <script>
        (function () {
            const shareBtn = document.getElementById('whatsAppShareBtn');
            if (!shareBtn) return;

            shareBtn.addEventListener('click', async function () {
                const shareUrl = shareBtn.dataset.shareUrl || '';
                const imageUrl = shareBtn.dataset.imageUrl || '';
                const imageAlt = shareBtn.dataset.imageAlt || '';
                const shareText = imageAlt
                    ? `${imageAlt}\n\nDetay linki:\n${shareUrl}`
                    : `Detay linki:\n${shareUrl}`;

                try {
                    if (imageUrl) {
                        const response = await fetch(imageUrl);
                        const blob = await response.blob();
                        const extension = (blob.type && blob.type.includes('/')) ? blob.type.split('/')[1] : 'jpg';
                        const file = new File([blob], `destination-photo.${extension}`, { type: blob.type || 'image/jpeg' });

                        if (navigator.canShare && navigator.canShare({ files: [file] }) && navigator.share) {
                            await navigator.share({
                                text: shareText,
                                files: [file]
                            });
                            return;
                        }
                    }
                } catch {
                }

                window.open('https://wa.me/?text=' + encodeURIComponent(shareText), '_blank', 'noopener');
            });
        })();

        (function () {
            const container = document.getElementById('destinationPhotoGrid');
            const moreBtn = document.getElementById('photoMoreBtn');
            const moreCount = document.getElementById('photoMoreCount');
            if (!container || !moreBtn || !moreCount) return;

            function hydrateDeferredMedia(scope) {
                const target = scope || container;
                const deferredImages = target.querySelectorAll('img.js-deferred-photo');
                deferredImages.forEach(function (img) {
                    const dataSrc = img.getAttribute('data-src');
                    const dataSrcSet = img.getAttribute('data-srcset');
                    const dataSizes = img.getAttribute('data-sizes');

                    if (dataSrc) {
                        img.setAttribute('src', dataSrc);
                        img.removeAttribute('data-src');
                    }

                    if (dataSrcSet) {
                        img.setAttribute('srcset', dataSrcSet);
                        img.removeAttribute('data-srcset');
                    }

                    if (dataSizes) {
                        img.setAttribute('sizes', dataSizes);
                        img.removeAttribute('data-sizes');
                    }

                    img.classList.remove('js-deferred-photo');
                });

                const deferredSources = target.querySelectorAll('source.js-deferred-photo-source');
                deferredSources.forEach(function (source) {
                    const dataSrcSet = source.getAttribute('data-srcset');
                    const dataSizes = source.getAttribute('data-sizes');

                    if (dataSrcSet) {
                        source.setAttribute('srcset', dataSrcSet);
                        source.removeAttribute('data-srcset');
                    }

                    if (dataSizes) {
                        source.setAttribute('sizes', dataSizes);
                        source.removeAttribute('data-sizes');
                    }

                    source.classList.remove('js-deferred-photo-source');
                });
            }

            function updateCount() {
                const hiddenItems = container.querySelectorAll('.js-destination-photo-item.d-none');
                const remaining = hiddenItems.length;

                if (remaining <= 0) {
                    moreBtn.classList.add('d-none');
                    return;
                }

                moreBtn.classList.remove('d-none');
                moreCount.textContent = '+' + remaining;
            }

            moreBtn.addEventListener('click', function () {
                const hiddenItems = container.querySelectorAll('.js-destination-photo-item.d-none');
                if (!hiddenItems.length) {
                    updateCount();
                    return;
                }

                hiddenItems.forEach(function (item) {
                    item.classList.remove('d-none');
                });

                updateCount();
            });

            const preloadDeferred = function () {
                hydrateDeferredMedia(container);
            };

            if (document.readyState === 'complete') {
                setTimeout(preloadDeferred, 200);
            } else {
                window.addEventListener('load', function () {
                    setTimeout(preloadDeferred, 200);
                }, { once: true });
            }

            updateCount();
        })();

        (function () {
            const toggleByRatingBtn = document.getElementById('togglePhotosByRatingBtn');
            const photoGrid = document.getElementById('destinationPhotoGrid');

            if (!toggleByRatingBtn || !photoGrid) return;

            toggleByRatingBtn.addEventListener('click', function (event) {
                event.preventDefault();
                photoGrid.classList.add('d-none');
            });
        })();
    </script>
}
        </div>
    </div>

    <div class="top-summary-wrap">
        <div class="top-summary-line">
            <span class="text-muted me-2 top-summary-item">Ortalama Puan</span>
            <button type="button"
                    id="togglePhotosByRatingBtn"
                    class="me-2 top-rating-badge top-rating-toggle"
                    aria-label="Fotoğrafları gizle ve başlıklara geç">@Html.RatingBadge(destinationAverageRating)</button>
            <span class="btn btn-sm btn-comment-link">Yorumlar (@destinationApprovedReviews.Count)</span>
            @if (!string.IsNullOrWhiteSpace(instagramUrl))
            {
                <a href="@instagramUrl" target="_blank" rel="noopener noreferrer" class="social-text-link instagram-link" title="Instagram" aria-label="Instagram">
                    Instagram
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(facebookUrl))
            {
                <a href="@facebookUrl" target="_blank" rel="noopener noreferrer" class="social-text-link facebook-link" title="Facebook" aria-label="Facebook">
                    Facebook
                </a>
            }
            <button type="button"
                    id="whatsAppShareBtn"
                    class="btn btn-sm btn-whatsapp-plain"
                    data-share-url="@sharePageUrl"
                    data-image-url="@imageUrlAbsolute"
                    data-image-alt="@firstImageAltText"
                    title="WhatsApp ile paylaş">
                <i class="bi bi-whatsapp me-1" aria-hidden="true"></i>Paylaş
            </button>
            @if (canAdd)
            {
                <a class="btn btn-sm btn-primary" asp-page="/Destinations/ManagePhotos" asp-route-id="@Model.Destination.Id" title="Ekle">+</a>
            }
        </div>
    </div>

    @if (Model.Destination.Images != null && Model.Destination.Images.Count > 0)
    {
        var orderedImages = Model.Destination.Images.OrderBy(x => x.Order).ToList();
        var hiddenCount = Math.Max(0, orderedImages.Count - 3);
        <div class="row g-3" id="destinationPhotoGrid">
            @for (var i = 0; i < orderedImages.Count; i++)
            {
                var img = orderedImages[i];
                var smallestImgUrl = Model.GetSmallestImageUrl(img.Url);
                if (string.IsNullOrWhiteSpace(smallestImgUrl)) { smallestImgUrl = img.Url; }
                var srcSet = Model.BuildSrcSet(img.Url);
                var isPriorityImage = i < 3;
                var hiddenClass = i >= 3 ? "d-none" : string.Empty;
                <!-- Mobilde tam ekran (col-12), tablet ve üstünde 3'lü dizilim (col-md-4) -->
                <div class="col-12 col-sm-6 col-md-4 js-destination-photo-item @hiddenClass">
                    <div class="card shadow-sm photo-card destination-card border-0 reveal-up">
                        <div class="photo-frame">
                            <picture>
                                @if (i < 3)
                                {
                                    @if (!string.IsNullOrEmpty(srcSet))
                                    {
                                        <source srcset="@srcSet" sizes="(max-width: 576px) 100vw, (max-width: 992px) 50vw, 33vw" type="image/webp" />
                                    }
                                }
                                else if (!string.IsNullOrEmpty(srcSet))
                                {
                                    <source class="js-deferred-photo-source" data-srcset="@srcSet" data-sizes="(max-width: 576px) 100vw, (max-width: 992px) 50vw, 33vw" type="image/webp" />
                                }
                                <img src="@(i < 3 ? smallestImgUrl : "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==")"
                                     srcset="@(i < 3 ? srcSet : null)"
                                     sizes="@(i < 3 ? "(max-width: 576px) 100vw, (max-width: 992px) 50vw, 33vw" : null)"
                                     data-src="@(i >= 3 ? smallestImgUrl : null)"
                                     data-srcset="@(i >= 3 ? srcSet : null)"
                                     data-sizes="@(i >= 3 ? "(max-width: 576px) 100vw, (max-width: 992px) 50vw, 33vw" : null)"
                                     alt="@(string.IsNullOrWhiteSpace(img.AltText) ? Model.Destination.Name : img.AltText)"
                                     width="600"
                                     height="400"
                                     class="card-img-top @(i >= 3 ? "js-deferred-photo" : null)"
                                     loading="@(isPriorityImage ? "eager" : "lazy")"
                                     fetchpriority="@(isPriorityImage ? "high" : "auto")"
                                     decoding="async" />
                            </picture>
                            @if (!string.IsNullOrWhiteSpace(img.AltText))
                            {
                                <span class="photo-alt-overlay">@img.AltText.Trim()</span>
                            }
                            @if (i == 2 && hiddenCount > 0)
                            {
                                <button type="button" id="photoMoreBtn" class="photo-more-trigger" aria-label="Diğer fotoğrafları göster">
                                    <span id="photoMoreCount" class="photo-more-count">+@hiddenCount</span>
                                </button>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>


    }
    else
    {
        <div class="alert alert-light border">Bu destinasyon için henüz fotoğraf bulunmuyor.</div>
    }

    <div id="afterPhotosHeadingAnchor"></div>

    @if (Model.Destination.Attractions?.Any() == true)
    {
        <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
            <h5 class="mb-0 details-name-align details-section-title">Gezilecek Yerler</h5>
            @if (canAdd)
            {
                <a class="btn btn-sm btn-primary" asp-controller="Attractions" asp-action="Create" asp-route-destinationId="@Model.Destination.Id" title="Ekle">+</a>
            }
        </div>

        <div class="row g-3 mb-4 mobile-three-cards">
            @foreach (var item in Model.Destination.Attractions.OrderByDescending(x => x.AverageRating).ThenBy(x => x.Name))
            {
                var googleQuery = $"{item.Name} {Model.Destination.Name}";
                var googleSearchUrl = $"https://www.google.com/search?q={Uri.EscapeDataString(googleQuery)}";
                var googleMapsUrl = $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(googleQuery)}";
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm info-card destination-card border-0 reveal-up">
                        <div class="card-body">
                            <h5 class="card-title mb-2 d-flex align-items-center gap-2">
                                <a href="@googleSearchUrl" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-reset attraction-name-link card-link-hover" title="Google'da ara: @googleQuery">
                                    @item.Name
                                </a>
                                <a href="@googleMapsUrl" target="_blank" rel="noopener noreferrer" class="text-decoration-none card-link-hover" title="Haritada aç: @googleQuery" aria-label="Haritada aç: @googleQuery">
                                    📍
                                </a>
                            </h5>
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0">
                            <div class="d-flex align-items-center gap-2">
                                <div>@Html.RatingBadge(item.AverageRating)</div>
                                <a class="btn btn-sm btn-comment-link"
                                   data-bs-toggle="collapse"
                                   href="#attraction-reviews-@item.Id"
                                   role="button"
                                   aria-expanded="false"
                                   aria-controls="attraction-reviews-@item.Id">Yorumlar (@(item.Reviews?.Count(r => r.IsApproved && !r.IsRejected) ?? 0))</a>
                                <a class="btn btn-sm btn-comment-link" asp-controller="Reviews" asp-action="Create" asp-route-attractionId="@item.Id" asp-route-returnUrl="@currentPhotoDetailsUrl">Yorum Ekle</a>
                                <div class="d-flex gap-2">
                                    @if (isAdmin)
                                    {
                                        <a class="btn btn-sm btn-primary" asp-controller="Attractions" asp-action="Edit" asp-route-id="@item.Id">Düzenle</a>
                                    }
                                </div>
                            </div>
                            <div class="collapse mt-2" id="attraction-reviews-@item.Id">
                                @{
                                    var approvedReviews = item.Reviews?
                                        .Where(r => r.IsApproved && !r.IsRejected)
                                        .OrderByDescending(r => r.CreatedAt)
                                        .ToList() ?? new List<Roma.Models.Review>();
                                }

                                @if (approvedReviews.Count == 0)
                                {
                                    <div class="small text-muted">Bu yer için henüz onaylı yorum bulunmuyor.</div>
                                }
                                else
                                {
