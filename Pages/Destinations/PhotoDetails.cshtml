@page "{id:int}"
@model Roma.Pages.Destinations.PhotoDetailsModel
@{
    ViewData["Title"] = "Fotoğraf Detayı";
    var canAdd = User?.Identity?.IsAuthenticated == true;
    var isAdmin = User?.IsInRole("Admin") == true;
}

@functions {
    private static string MaskEmail(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return "Misafir";
        }

        var clean = email.Trim();
        if (clean.Length == 1)
        {
            return $"{clean[0]}***";
        }

        return $"{clean[0]}***{clean[^1]}";
    }
}

@section Head {
    <style>
