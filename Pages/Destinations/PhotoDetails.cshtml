                                        }
                                    </div>
                                </div>
                                <div class="collapse mt-2" id="attraction-reviews-@item.Id">
                                    @{
                                        var approvedReviews = item.Reviews?
                                            .Where(r => r.IsApproved && !r.IsRejected)
                                            .OrderByDescending(r => r.CreatedAt)
                                            .ToList() ?? new List<Roma.Models.Review>();
