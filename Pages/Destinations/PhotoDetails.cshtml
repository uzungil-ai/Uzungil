@page "{id:int}"
@model Roma.Pages.Destinations.PhotoDetailsModel
@{
    ViewData["Title"] = "Fotoğraf Detayı";
    var canAdd = User?.Identity?.IsAuthenticated == true;
    var isAdmin = User?.IsInRole("Admin") == true;
}

@functions {
    private static string MaskEmail(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return "Misafir";
        }

        var clean = email.Trim();
        if (clean.Length == 1)
        {
            return $"{clean[0]}***";
        }

        return $"{clean[0]}***{clean[^1]}";
    }
}

@section Head {
    <style>
        .info-card {
            height: 100%;
            transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
            background: #fff !important;
        }

        .photo-details-page .destination-card {
            border: 1px solid var(--site-border-blue-soft) !important;
            border-radius: var(--radius-md);
            overflow: hidden;
            background: #fff;
            transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
