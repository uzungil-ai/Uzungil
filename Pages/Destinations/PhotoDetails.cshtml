            font-weight: 700;
        }

        .top-summary-line .btn-whatsapp-plain {
            white-space: normal;
            text-align: left;
            line-height: 1.2;
        }

        .social-text-link.instagram-link {
            color: #dc2626;
        }

        .social-text-link.facebook-link {
            color: #2563eb;
        }

        .social-text-link:hover,
        .social-text-link:focus {
            text-decoration: underline;
            text-decoration-thickness: 4px;
            text-underline-offset: 2px;
        }

        .social-text-link.instagram-link:hover,
        .social-text-link.instagram-link:focus {
            color: #b91c1c;
        }

        .social-text-link.facebook-link:hover,
        .social-text-link.facebook-link:focus {
            color: #1d4ed8;
        }

        @@media (max-width: 767.98px) {
            .mobile-three-cards {
                flex-wrap: wrap;
            }

            .mobile-three-cards > [class*="col-"] {
                flex: 0 0 50%;
                max-width: 50%;
            }

            .top-summary-wrap {
                justify-content: center;
            }

            .top-summary-line {
                justify-content: center;
                text-align: center;
                width: 100%;
            }

            .top-summary-line .top-summary-item,
            .top-summary-line .top-rating-badge,
            .top-summary-line .social-text-link,
            .top-summary-line .btn-comment-link,
            .top-summary-line .btn-whatsapp-plain {
