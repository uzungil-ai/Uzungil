            font-size: 1.25rem;
            font-weight: 700;
            line-height: 1.2;
        }

        .top-summary-line .top-summary-item {
            font-size: 1.25rem;
            font-weight: 400;
            line-height: 1.2;
        }

        .top-summary-wrap {
            display: flex;
            justify-content: center;
            margin-bottom: .5rem;
        }

        .top-summary-line {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: .35rem .75rem;
            max-width: 100%;
            padding: .3rem .55rem;
            border-radius: 10px;
        }

        .top-rating-toggle {
            text-decoration: none;
            color: inherit;
            cursor: pointer;
            border: 0;
            background: transparent;
            padding: 0;
        }

        .top-rating-toggle:hover,
        .top-rating-toggle:focus {
            text-decoration: none;
