        }

        .details-section-title {
            font-weight: 700;
            color: #1f4fd6;
            text-shadow: 0 1px 6px rgba(0, 0, 0, 0.18);
        }

        .btn-whatsapp-plain {
            border: 0 !important;
            background: transparent !important;
