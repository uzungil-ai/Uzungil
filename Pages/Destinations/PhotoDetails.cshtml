<div class="photo-details-page">
<br />
<br />
@if (Model.Destination != null)
{
    var couponSuccess = TempData["CouponSuccess"] as string;
    var couponError = TempData["CouponError"] as string;
    var firstImageItem = Model.Destination.Images?.OrderBy(x => x.Order).FirstOrDefault();
    var firstImage = firstImageItem?.Url ?? string.Empty;
    var firstImageAltText = string.IsNullOrWhiteSpace(firstImageItem?.AltText)
        ? Model.Destination.Name
        : firstImageItem!.AltText!.Trim();
    var sharePageUrl = $"https://www.fotografia.com.tr/Destinations/PhotoDetails/{Model.Destination.Id}";
    var imageUrlAbsolute = string.IsNullOrWhiteSpace(firstImage)
        ? string.Empty
        : ((firstImage.StartsWith("http://") || firstImage.StartsWith("https://"))
            ? firstImage
            : $"https://www.fotografia.com.tr{firstImage}");
    var instagramUrl = string.IsNullOrWhiteSpace(Model.Destination.InstagramUrl)
        ? string.Empty
        : (Model.Destination.InstagramUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
           Model.Destination.InstagramUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            ? Model.Destination.InstagramUrl
            : $"https://{Model.Destination.InstagramUrl}");
    var facebookUrl = string.IsNullOrWhiteSpace(Model.Destination.FacebookUrl)
        ? string.Empty
        : (Model.Destination.FacebookUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
           Model.Destination.FacebookUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            ? Model.Destination.FacebookUrl
            : $"https://{Model.Destination.FacebookUrl}");
    var currentPhotoDetailsUrl = $"/Destinations/PhotoDetails/{Model.Destination.Id}";

    if (!string.IsNullOrWhiteSpace(couponSuccess))
    {
        <div id="couponToast" class="coupon-toast" role="status" aria-live="polite">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <div>
                    <div class="coupon-toast-title">Bilgilendirme</div>
                    <div>@couponSuccess</div>
                </div>
                <button type="button" class="coupon-toast-close" aria-label="Kapat" onclick="document.getElementById('couponToast')?.remove()">×</button>
            </div>
        </div>
    }

    if (!string.IsNullOrWhiteSpace(couponError))
    {
        <div class="alert alert-warning">@couponError</div>
    }
    var destinationApprovedReviewItems = (Model.Destination.Attractions ?? new List<Roma.Models.Attraction>())
        .SelectMany(a => (a.Reviews ?? new List<Roma.Models.Review>())
            .Where(r => r.IsApproved && !r.IsRejected)
            .Select(r => new
            {
                Title = string.IsNullOrWhiteSpace(a.Name) ? "Başlıksız" : a.Name,
                Review = r
            }))
        .OrderByDescending(x => x.Review.CreatedAt)
        .ToList();
    var destinationAverageRating = destinationApprovedReviewItems.Any()
        ? destinationApprovedReviewItems.Average(x => x.Review.Rating)
        : 0;
    var discountMealsCount = (Model.Destination.Meals ?? new List<Roma.Models.Meal>())
        .Count(x => Model.HasSubscriberDiscount(x.Id));

    <div class="card mb-4 shadow-sm destination-card border-0 reveal-up">
        <div class="card-body">
            <h4 class="mb-3 details-section-title">@Model.Destination.Name</h4>
            <div class="row">
                <div class="col-12 details-plain-text">@Model.Destination.Description</div>
            </div>

@section Scripts {
    <script>
        (function () {
            const couponToast = document.getElementById('couponToast');
            if (couponToast) {
                setTimeout(function () {
                    couponToast.remove();
                }, 6000);
            }
        })();

        (function () {
            const shareBtn = document.getElementById('whatsAppShareBtn');
            if (!shareBtn) return;

            shareBtn.addEventListener('click', async function () {
                const shareUrl = shareBtn.dataset.shareUrl || '';
                const imageUrl = shareBtn.dataset.imageUrl || '';
                const imageAlt = shareBtn.dataset.imageAlt || '';
                const shareText = imageAlt
                    ? `${imageAlt}\n\nDetay linki:\n${shareUrl}`
                    : `Detay linki:\n${shareUrl}`;

                try {
                    if (imageUrl) {
                        const response = await fetch(imageUrl);
                        const blob = await response.blob();
                        const extension = (blob.type && blob.type.includes('/')) ? blob.type.split('/')[1] : 'jpg';
                        const file = new File([blob], `destination-photo.${extension}`, { type: blob.type || 'image/jpeg' });

                        if (navigator.canShare && navigator.canShare({ files: [file] }) && navigator.share) {
                            await navigator.share({
                                text: shareText,
                                files: [file]
                            });
                            return;
                        }
                    }
                } catch {
                }

                window.open('https://wa.me/?text=' + encodeURIComponent(shareText), '_blank', 'noopener');
            });
        })();

        (function () {
            const container = document.getElementById('destinationPhotoGrid');
            const moreBtn = document.getElementById('photoMoreBtn');
            const moreCount = document.getElementById('photoMoreCount');
            if (!container || !moreBtn || !moreCount) return;

            function hydrateDeferredMedia(scope) {
                const target = scope || container;
                const deferredImages = target.querySelectorAll('img.js-deferred-photo');
                deferredImages.forEach(function (img) {
                    const dataSrc = img.getAttribute('data-src');
                    const dataSrcSet = img.getAttribute('data-srcset');
                    const dataSizes = img.getAttribute('data-sizes');

                    if (dataSrc) {
                        img.setAttribute('src', dataSrc);
                        img.removeAttribute('data-src');
                    }

                    if (dataSrcSet) {
                        img.setAttribute('srcset', dataSrcSet);
                        img.removeAttribute('data-srcset');
                    }

                    if (dataSizes) {
                        img.setAttribute('sizes', dataSizes);
                        img.removeAttribute('data-sizes');
                    }

                    img.classList.remove('js-deferred-photo');
                });

                const deferredSources = target.querySelectorAll('source.js-deferred-photo-source');
                deferredSources.forEach(function (source) {
                    const dataSrcSet = source.getAttribute('data-srcset');
                    const dataSizes = source.getAttribute('data-sizes');

                    if (dataSrcSet) {
                        source.setAttribute('srcset', dataSrcSet);
                        source.removeAttribute('data-srcset');
                    }

                    if (dataSizes) {
                        source.setAttribute('sizes', dataSizes);
                        source.removeAttribute('data-sizes');
                    }

                    source.classList.remove('js-deferred-photo-source');
                });
            }

            function updateCount() {
                const hiddenItems = container.querySelectorAll('.js-destination-photo-item.d-none:not(.js-passed-photo-item)');
                const remaining = hiddenItems.length;

                if (remaining <= 0) {
                    moreBtn.classList.add('d-none');
                    return;
                }

                moreBtn.classList.remove('d-none');
                moreCount.textContent = '+' + remaining;
            }

            moreBtn.addEventListener('click', function () {
                const visibleItems = container.querySelectorAll('.js-destination-photo-item:not(.d-none):not(.js-passed-photo-item)');
                const hiddenItems = container.querySelectorAll('.js-destination-photo-item.d-none:not(.js-passed-photo-item)');
                if (!hiddenItems.length) {
                    updateCount();
                    return;
                }

                visibleItems.forEach(function (item) {
                    item.classList.add('js-passed-photo-item');
                    item.classList.add('d-none');
                });

                hiddenItems.forEach(function (item) {
                    item.classList.remove('d-none');
                });

                updateCount();
            });

            function scheduleDeferredPhotoHydration() {
                if ('requestIdleCallback' in window) {
                    window.requestIdleCallback(function () {
                        hydrateDeferredMedia(container);
                    }, { timeout: 1400 });
                    return;
                }

                setTimeout(function () {
                    hydrateDeferredMedia(container);
                }, 300);
            }

            if (document.readyState === 'complete') {
                scheduleDeferredPhotoHydration();
            } else {
                window.addEventListener('load', function () {
                    scheduleDeferredPhotoHydration();
                }, { once: true });
            }

            updateCount();
        })();

        (function () {
            const grid = document.getElementById('destinationPhotoGrid');
            const deferredPairs = [
                { section: document.getElementById('attractionsDeferredSection'), loader: document.getElementById('attractionsDeferredLoader') },
                { section: document.getElementById('hotelsDeferredSection'), loader: document.getElementById('hotelsDeferredLoader') },
                { section: document.getElementById('mealsDeferredSection'), loader: document.getElementById('mealsDeferredLoader') },
                { section: document.getElementById('flavorsDeferredSection'), loader: document.getElementById('flavorsDeferredLoader') },
                { section: document.getElementById('parkingsDeferredSection'), loader: document.getElementById('parkingsDeferredLoader') }
            ].filter(function (x) { return !!x.section; });

            if (!deferredPairs.length) return;

            function revealDeferredSections() {
                deferredPairs.forEach(function (pair) {
                    pair.section.classList.remove('d-none');
                    pair.section.removeAttribute('aria-hidden');
                    if (pair.loader) {
                        pair.loader.classList.add('d-none');
                    }
                });
            }

            function scheduleReveal() {
                if ('requestIdleCallback' in window) {
                    window.requestIdleCallback(function () {
                        revealDeferredSections();
                    }, { timeout: 1200 });
                    return;
                }

                setTimeout(revealDeferredSections, 220);
            }

            if (!grid) {
                scheduleReveal();
                return;
            }

            const firstImages = Array.from(grid.querySelectorAll('.js-destination-photo-item:not(.d-none) img')).slice(0, 3);
            if (!firstImages.length) {
                scheduleReveal();
                return;
            }

            let remaining = firstImages.length;
            function onReady() {
                remaining--;
                if (remaining <= 0) {
                    scheduleReveal();
                }
            }

            firstImages.forEach(function (img) {
                if (img.complete) {
                    onReady();
                } else {
                    img.addEventListener('load', onReady, { once: true });
                    img.addEventListener('error', onReady, { once: true });
                }
            });
        })();

        (function () {
            const toggleByRatingBtn = document.getElementById('togglePhotosByRatingBtn');
            const photoGrid = document.getElementById('destinationPhotoGrid');

            if (!toggleByRatingBtn || !photoGrid) return;

            toggleByRatingBtn.addEventListener('click', function (event) {
                event.preventDefault();
                photoGrid.classList.add('d-none');
            });
        })();

        (function () {
            const filterLink = document.getElementById('discountMealsFilterLink');
            const mealsSection = document.getElementById('mealsDeferredSection');
            const mealsLoader = document.getElementById('mealsDeferredLoader');
            const mealsGrid = document.getElementById('mealsGrid');
            const emptyNotice = document.getElementById('discountMealsOnlyNotice');

            if (!filterLink || !mealsSection || !mealsGrid) return;

            filterLink.addEventListener('click', function (event) {
                event.preventDefault();

                // Sadece restoran/cafe kartlarını bırak, diğer bölümleri gizle
                const sectionsToHide = [
                    'destinationPhotoGrid',
                    'attractionsDeferredSection',
                    'hotelsDeferredSection',
                    'flavorsDeferredSection',
                    'parkingsDeferredSection',
                    'destination-all-reviews'
                ];

                sectionsToHide.forEach(function (id) {
                    const el = document.getElementById(id);
                    if (el) {
                        el.classList.add('d-none');
                    }
                });

                const loadersToHide = [
                    'attractionsDeferredLoader',
                    'hotelsDeferredLoader',
                    'flavorsDeferredLoader',
                    'parkingsDeferredLoader'
                ];

                loadersToHide.forEach(function (id) {
                    const el = document.getElementById(id);
                    if (el) {
                        el.classList.add('d-none');
                    }
                });

                mealsSection.classList.remove('d-none');
                mealsSection.removeAttribute('aria-hidden');
                if (mealsLoader) {
                    mealsLoader.classList.add('d-none');
                }

                const mealCards = mealsGrid.querySelectorAll('.js-meal-item');
                let visibleCount = 0;

                mealCards.forEach(function (card) {
                    const hasDiscount = card.getAttribute('data-discount') === '1';
                    if (hasDiscount) {
                        card.classList.remove('d-none');
                        visibleCount++;
                    } else {
                        card.classList.add('d-none');
                    }
                });

                if (emptyNotice) {
                    emptyNotice.classList.toggle('d-none', visibleCount > 0);
                }

                mealsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        })();
    </script>
}
        </div>
    </div>

    <div class="top-summary-wrap">
        <div class="top-summary-line">
            <span class="text-muted me-2 top-summary-item">Ortalama Puan</span>
            <button type="button"
                    id="togglePhotosByRatingBtn"
                    class="me-2 top-rating-badge top-rating-toggle"
                    aria-label="Fotoğrafları gizle ve başlıklara geç">@Html.RatingBadge(destinationAverageRating)</button>
            <a class="btn btn-sm btn-comment-link"
               data-bs-toggle="collapse"
               href="#destination-all-reviews"
               role="button"
               aria-expanded="false"
               aria-controls="destination-all-reviews">Yorum listesi (@destinationApprovedReviewItems.Count)</a>
            <a href="#"
               id="discountMealsFilterLink"
               class="social-text-link discount-link"
