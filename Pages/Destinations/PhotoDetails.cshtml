                var hotelSearchUrl = $"https://www.google.com/search?q={Uri.EscapeDataString(hotelQuery)}";
                var hotelMapsUrl = $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(hotelQuery)}";
                var hotelAttraction = (Model.Destination.Attractions ?? new List<Roma.Models.Attraction>())
                    .FirstOrDefault(a => string.Equals(a.Name?.Trim(), item.Name?.Trim(), StringComparison.OrdinalIgnoreCase));
                var hotelApprovedReviews = hotelAttraction?.Reviews?
                    .Where(r => r.IsApproved && !r.IsRejected)
                    .OrderByDescending(r => r.CreatedAt)
                    .ToList() ?? new List<Roma.Models.Review>();
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm info-card destination-card border-0 reveal-up">
                        <div class="card-body">
                            <div class="fw-semibold mb-2 d-flex align-items-center gap-2">
                                <a href="@hotelSearchUrl" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-reset attraction-name-link card-link-hover" title="Google'da ara: @hotelQuery">@item.Name</a>
                                <a href="@hotelMapsUrl" target="_blank" rel="noopener noreferrer" class="text-decoration-none card-link-hover" title="Haritada aç: @hotelQuery" aria-label="Haritada aç: @hotelQuery">📍</a>
                            </div>
                            <div class="small text-muted details-value-line">
                                @if (!string.IsNullOrWhiteSpace(item.Website))
                                {
                                    var websiteUrl = item.Website.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                                                     item.Website.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
                                        ? item.Website
                                        : $"https://{item.Website}";

                                    <a class="btn btn-sm btn-navbar-theme" href="@websiteUrl" target="_blank" rel="noopener noreferrer" title="Otel web sitesini aç">
                                        Link
                                    </a>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </div>
                            <div class="small text-muted"><strong>Başlangıç Fiyatı:</strong> @(item.PriceFrom.HasValue ? $"{item.PriceFrom.Value:0.##} TL" : "-")</div>
                            <div class="small text-muted"><strong>Üst Fiyat:</strong> @(item.PriceTo.HasValue ? $"{item.PriceTo.Value:0.##} TL" : "-")</div>
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0 d-flex flex-wrap gap-2">
                            <a class="btn btn-sm btn-comment-link"
                               data-bs-toggle="collapse"
                               href="#hotel-reviews-@item.Id"
                               role="button"
                               aria-expanded="false"
                               aria-controls="hotel-reviews-@item.Id">Yorumlar (@hotelApprovedReviews.Count)</a>
                            @if (hotelAttraction != null)
                            {
                                <a class="btn btn-sm btn-comment-link" asp-controller="Reviews" asp-action="Create" asp-route-attractionId="@hotelAttraction.Id" asp-route-returnUrl="@currentPhotoDetailsUrl">Yorum Ekle</a>
                            }
                        </div>
                        <div class="collapse mt-2 px-3 pb-3" id="hotel-reviews-@item.Id">
                            @if (hotelApprovedReviews.Count == 0)
                            {
                                <div class="small text-muted">Bu konaklama için henüz onaylı yorum bulunmuyor.</div>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var review in hotelApprovedReviews)
                                    {
                                        <div class="list-group-item px-0">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
