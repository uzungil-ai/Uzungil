@page
@model Roma.Pages.IndexModel
@{
    ViewData["Title"] = "Roma - Keşfet";
}

<div class="hero text-center py-5" style="background:#f5f5f5;">
    <div class="container">
        <h1 class="display-5">Roma ile keşfetmeye hazır mısın?</h1>
        <p class="lead">En güzel destinasyonları gör, yerel lezzetleri keşfet ve seyahat planlarını oluştur.</p>
        <form id="subscribeForm" method="post" asp-page="Subscribe" class="d-flex justify-content-center mt-3">
            @Html.AntiForgeryToken()
            <input type="email" id="subEmail" name="Email" placeholder="E-posta adresiniz" class="form-control w-50" />
            <label class="visually-hidden" for="subConsent">Consent</label>
            <input type="checkbox" id="subConsent" name="Consent" class="form-check-input ms-2" />
            <button type="button" id="subBtn" class="btn btn-primary ms-2">Abone Ol</button>
        </form>
        <div id="subMessage" class="mt-2 text-center"></div>
    </div>
</div>

<div class="container my-5">
    <h2 class="mb-4">Öne çıkan destinasyonlar</h2>
    <div class="mb-4">
        <a class="btn btn-outline-primary" href="/Chat">Sohbet Botu</a>
    </div>
    <div class="row">
        @foreach(var d in Model.Featured)
        {
            var img = d.Images.FirstOrDefault()?.Url ?? "/images/italya.jpg";
            var srcset = Model.BuildSrcSet(img);
            <div class="col-12 col-sm-6 col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <picture>
                        @if(!string.IsNullOrEmpty(srcset)){
                            <source srcset="@srcset" type="image/webp" />
                        }
                        <img class="card-img-top" src="@img" loading="lazy" alt="@d.Name" />
                    </picture>
                    <div class="card-body">
                        <h5 class="card-title">@d.Name</h5>
                        <p class="card-text">@d.Country</p>
                        <p class="small text-muted">@((d.Description?.Length>120)?d.Description.Substring(0,120)+"...":d.Description)</p>
                        <a asp-page="/Admin/Destinations/Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">Detay</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<footer class="border-top py-4">
    <div class="container text-center">
        <p class="mb-0">© 2026 Roma</p>
    </div>
</footer>

@section Scripts {
    <script>
        (function(){
            var btn = document.getElementById('subBtn');
            var email = document.getElementById('subEmail');
            var consent = document.getElementById('subConsent');
            var msg = document.getElementById('subMessage');
            var form = document.getElementById('subscribeForm');
            btn?.addEventListener('click', function(){
                msg.textContent = '';
                if(!email.value){ msg.textContent = 'E-posta giriniz.'; return; }
                if(!consent.checked){ msg.textContent = 'Lütfen rıza veriniz.'; return; }

                var data = new FormData();
                data.append('Email', email.value);
                data.append('Consent', consent.checked ? 'true' : 'false');

                var tokenEl = form.querySelector('input[name="__RequestVerificationToken"]');
                if(tokenEl) data.append('__RequestVerificationToken', tokenEl.value);

                btn.disabled = true; btn.textContent = 'Gönderiliyor...';

                fetch(form.action, { method: 'POST', body: data }).then(function(resp){
                    if(resp.redirected){ window.location = resp.url; return; }
                    return resp.text();
                }).then(function(text){
                    msg.textContent = 'Abonelik isteğiniz alındı. Lütfen e-postanızı kontrol edin.';
                }).catch(function(){ msg.textContent = 'Hata oluştu.'; })
                .finally(function(){ btn.disabled = false; btn.textContent = 'Abone Ol'; });
            });
        })();
    </script>
}
