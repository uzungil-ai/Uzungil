@page
@model Roma.Pages.IndexModel
@{
    ViewData["Title"] = "Fotografia ile - Keşfet";
    var firstFeatured = Model.Featured.FirstOrDefault();
    var firstFeaturedImage = Model.GetSmallestImageUrl(firstFeatured?.Images.FirstOrDefault()?.Url);
    if (string.IsNullOrWhiteSpace(firstFeaturedImage))
    {
        firstFeaturedImage = "/images/italya.jpg";
    }
    var firstFeaturedName = firstFeatured?.Name ?? "Fotografia";
    var categoryOptions = Model.CategoryOptions;
    var selectedCategory = Model.Category ?? string.Empty;
}

@section Head {
    <link rel="preload" as="image" href="@firstFeaturedImage" fetchpriority="high" />

    <style>
        #homeSplash {
            position: fixed;
            inset: 0;
            z-index: 2000;
            background: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 1;
            visibility: visible;
            transition: opacity .35s ease, visibility .35s ease;
        }

        html.home-splash-seen #homeSplash {
            display: none !important;
        }

        #homeSplash.is-hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        #homeSplash img {
            width: 100vw;
            height: 100vh;
            object-fit: cover;
        }

        #homeSplash .home-splash-title {
            position: absolute;
            left: 50%;
            top: calc(50% - 7.2rem);
            transform: translate(-50%, -50%);
            color: #b45309;
            font-size: clamp(4rem, 10.4vw, 5.6rem);
            text-align: center;
            text-shadow: 0 3px 10px rgba(0, 0, 0, .75);
            font-weight: 700;
            margin: 0;
        }

        #homeSplash .home-splash-subtitle {
            position: absolute;
            left: 50%;
            top: calc(50% - 3.8rem);
            transform: translateX(-50%);
            color: #b45309;
            font-size: clamp(4rem, 10.4vw, 5.6rem);
            text-align: center;
            text-shadow: 0 2px 6px rgba(0, 0, 0, .45);
            font-weight: 700;
            margin: 0;
        }

        #homeSplash .home-splash-search {
            position: absolute;
            left: 50%;
            top: calc(50% + 4.5rem);
            transform: translateX(-50%);
            width: min(92vw, 660px);
            display: flex;
            gap: .5rem;
            padding: .5rem;
            border-radius: 999px;
            background: rgba(15, 23, 42, .45);
            border: 0;
            backdrop-filter: blur(4px);
        }

        #homeSplash .home-splash-search .form-control {
            border-radius: 999px;
            flex: 1 1 auto;
            min-width: 0;
        }

        #homeSplash .home-splash-search .btn {
            border-radius: 999px;
            white-space: nowrap;
            flex: 0 0 auto;
        }

        #homeSplash .home-splash-actions {
            position: absolute;
            left: 50%;
            bottom: 9vh;
            transform: translateX(-50%);
            width: min(92vw, 980px);
            display: flex;
            flex-wrap: wrap;
            gap: .6rem;
            justify-content: center;
        }

        #homeSplash .splash-cta {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: .6rem .95rem;
            border-radius: 999px;
            color: #fff;
            text-decoration: none;
            font-weight: 700;
            letter-spacing: .01em;
            border: 1px solid rgba(255,255,255,.45);
            backdrop-filter: blur(3px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, .28);
        }

        #homeSplash .splash-cta-chat { background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); }
        #homeSplash .splash-cta-ai { background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%); }
        #homeSplash .splash-cta-plan { background: linear-gradient(135deg, #059669 0%, #047857 100%); }
        #homeSplash .splash-cta-review { background: linear-gradient(135deg, #c2410c 0%, #9a3412 100%); }
        #homeSplash .splash-cta-brand { background: var(--navbar-theme-gradient); }
        #homeSplash .splash-cta-whatsapp { background: linear-gradient(135deg, #25d366 0%, #128c7e 100%); }
        #homeSplash .splash-cta-about { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); }

        .js-destination-item {
            content-visibility: auto;
            contain-intrinsic-size: 320px;
        }

        .hero-scroll-btn {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            border: 2px solid #fff;
            color: #fff !important;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, .2);
        }

        .hero-scroll-btn svg {
            width: 28px;
            height: 28px;
        }

        .hero-scroll-btn:hover,
        .hero-scroll-btn:focus {
            color: #fff !important;
            border-color: #fff;
            background: rgba(0, 0, 0, .35);
        }

        @@media (max-width: 768px) {
            #homeSplash {
                background: transparent;
            }

            #homeSplash img {
                width: auto;
                height: auto;
                max-width: none;
                max-height: none;
                object-fit: contain;
                transform: scale(2);
                transform-origin: center;
            }

            #homeSplash .home-splash-subtitle {
                top: calc(50% - 2.6rem);
            }

            #homeSplash .home-splash-title {
                top: calc(50% - 5.6rem);
            }

            #homeSplash .home-splash-search {
                top: calc(50% + 3.8rem);
                width: min(calc(94vw * 0.8), 448px);
                padding: .4rem;
            }

            #homeSplash .home-splash-search .form-control:focus {
                width: 100%;
                transform: none;
            }

            #homeSplash .home-splash-actions {
                bottom: 7vh;
                gap: .45rem;
            }

            #homeSplash .splash-cta {
                font-size: .9rem;
                padding: .5rem .8rem;
            }
        }
    </style>
}

<script>
    (function () {
        try {
            if (localStorage.getItem('homeSplashSeen') === '1') {
                document.documentElement.classList.add('home-splash-seen');
            }
        } catch {
        }
    })();
</script>

<div id="homeSplash" aria-hidden="true">
    <img src="@firstFeaturedImage" alt="@firstFeaturedName" loading="eager" fetchpriority="high" decoding="async" />
    <div class="home-splash-search" aria-label="Ana sayfa arama">
        <input name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Örn: Kapadokya veya Türkiye" />
        <button type="button" class="btn fw-semibold btn-soft-yellow-action">Ara</button>
    </div>
    <div class="home-splash-actions" aria-label="Hızlı işlemler">
        <a class="splash-cta splash-cta-chat" href="/Chat">Nereye gitmek istersiniz</a>
        <a class="splash-cta splash-cta-ai" href="/OpenAiSoruCevap">Yapay zekaya sor</a>
        <a class="splash-cta splash-cta-plan" href="/SeyahatPlanla">Seyahat planla</a>
        <a class="splash-cta splash-cta-whatsapp" href="https://wa.me/?text=Fotografia%20-%20https%3A%2F%2Ffotografia.com.tr" target="_blank" rel="noopener noreferrer">What-up ile paylaş</a>
        <a class="splash-cta splash-cta-about" asp-controller="Home" asp-action="Hakkında">Hakkında</a>
    </div>
</div>

<div class="home-under-hero-bg">
<section class="container hero-search-slider-wrap">
    <div class="hero-search-card shadow-sm">
        <div class="home-actions-bar mb-0" aria-label="Hızlı işlemler">
            <div class="home-tabs home-actions">
                <button type="button" class="home-tab-btn home-action-link active home-navbar-theme-btn home-top-soft-btn home-subscribe-soft-btn" data-bs-toggle="modal" data-bs-target="#subscribeModal">Abone Ol</button>
                <a class="home-tab-btn home-action-link home-action-yellow home-top-soft-btn" href="/Chat">Chat</a>
                <a class="home-tab-btn home-action-link home-action-yellow home-top-soft-btn" href="/OpenAiSoruCevap">Aİ-Sor</a>
                <a class="home-tab-btn home-action-link home-action-yellow home-top-soft-btn" href="/SeyahatPlanla">Seyahat Planı</a>
            </div>
            <div class="destination-top-search-wrap home-actions-search-wrap home-actions-search-inline" aria-label="Destinasyon arama">
                <div class="destination-top-search-form">
                    <div class="hero-search-grid destination-top-search-grid">
                        <div class="hero-search-field">
                            <input id="hero-search" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Örn: Kapadokya veya Türkiye" />
                        </div>
                        <div class="hero-search-action destination-top-search-action">
                            <button type="button" class="home-tab-btn home-action-link btn-soft-yellow-action" aria-label="Ara">
                                Ara
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="heroSliderArea" class="hero-featured-strip-wrap mb-4 d-none">
            <button type="button" class="btn btn-sm btn-outline-primary hero-scroll-btn hero-scroll-btn-left js-hero-scroll" data-direction="left" aria-label="Sola kaydır">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path fill-rule="evenodd" d="M8.354 1.646a.5.5 0 0 1 0 .708L2.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0" />
                    <path fill-rule="evenodd" d="M12.354 1.646a.5.5 0 0 1 0 .708L6.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0" />
                </svg>
            </button>

            <div id="heroFeaturedStrip" class="hero-featured-strip" role="region" aria-label="Öne çıkan destinasyon görselleri">
                @if (Model.Featured.Any())
                {
                    @for (var i = 0; i < Math.Min(6, Model.Featured.Count); i++)
                    {
                        var d = Model.Featured[i];
                        var img = Model.GetSmallestImageUrl(d.Images.FirstOrDefault()?.Url);
                        if (string.IsNullOrWhiteSpace(img)) { img = "/images/italya.jpg"; }
                        var heroSrcSet = Model.BuildSrcSet(img);
                        var isFirstSlideImage = i == 0;
                        <a class="hero-featured-item" asp-page="/Destinations/PhotoDetails" asp-route-id="@d.Id" aria-label="@d.Name detaylarını görüntüle">
                            <picture>
                                @if (!string.IsNullOrEmpty(heroSrcSet))
                                {
                                    <source srcset="@heroSrcSet" sizes="(max-width: 768px) 40vw, 220px" type="image/webp" />
                                }
                                <img src="@img"
                                     srcset="@heroSrcSet"
                                     sizes="(max-width: 768px) 40vw, 220px"
                                     alt="@d.Name"
                                     loading="@(isFirstSlideImage ? "eager" : "lazy")"
                                     fetchpriority="@(isFirstSlideImage ? "high" : "auto")"
                                     decoding="async" />
                            </picture>
                            <span>@d.Name</span>
                        </a>
                    }
                }
                else
                {
                    <div class="alert alert-light border mb-0 w-100">Henüz öne çıkan içerik bulunmuyor.</div>
                }
            </div>

            <button type="button" class="btn btn-sm btn-outline-primary hero-scroll-btn hero-scroll-btn-right js-hero-scroll" data-direction="right" aria-label="Sağa kaydır">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path fill-rule="evenodd" d="M3.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L9.293 8 3.646 2.354a.5.5 0 0 1 0-.708" />
                    <path fill-rule="evenodd" d="M7.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L13.293 8 7.646 2.354a.5.5 0 0 1 0-.708" />
                </svg>
            </button>
        </div>

    </div>
</section>

<section id="explore" class="container mt-0 mb-5 home-explore-section">

    <div id="featured-list" class="home-tab-panel d-none">
        <div class="row g-2">
            @for (var i = 0; i < Model.Featured.Count; i++)
            {
                var d = Model.Featured[i];
                var img = Model.GetSmallestImageUrl(d.Images.FirstOrDefault()?.Url);
                if (string.IsNullOrWhiteSpace(img)) { img = "/images/italya.jpg"; }
                var srcset = Model.BuildSrcSet(img);
                var isPriorityImage = i < 6;
                var isDeferredFeaturedImage = i >= 6;
                var hiddenClass = i >= 6 ? "d-none" : string.Empty;
                <div class="col-12 col-sm-6 col-md-4 mb-2 js-destination-item @hiddenClass">
                    <div class="card h-100 shadow-sm destination-card border-0 reveal-up">
                        <a class="destination-image-link" asp-page="/Destinations/PhotoDetails" asp-route-id="@d.Id">
                            <picture>
                                @if (!string.IsNullOrEmpty(srcset) && !isDeferredFeaturedImage)
                                {
                                    <source srcset="@srcset" sizes="(max-width: 576px) 100vw, (max-width: 992px) 50vw, 33vw" type="image/webp" />
                                }
                                else if (!string.IsNullOrEmpty(srcset))
                                {
                                    <source class="js-featured-deferred-source" data-srcset="@srcset" data-sizes="(max-width: 576px) 100vw, (max-width: 992px) 50vw, 33vw" type="image/webp" />
                                }
                                <img class="card-img-top destination-image @(isDeferredFeaturedImage ? "js-featured-deferred" : null)" src="@(isDeferredFeaturedImage ? "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" : img)" srcset="@(isDeferredFeaturedImage ? null : srcset)" sizes="@(isDeferredFeaturedImage ? null : "(max-width: 576px) 100vw, (max-width: 992px) 50vw, 33vw")" data-src="@(isDeferredFeaturedImage ? img : null)" data-srcset="@(isDeferredFeaturedImage ? srcset : null)" data-sizes="@(isDeferredFeaturedImage ? "(max-width: 576px) 100vw, (max-width: 992px) 50vw, 33vw" : null)" loading="@(isPriorityImage ? "eager" : "lazy")" fetchpriority="@(isPriorityImage ? "high" : "auto")" decoding="async" alt="@d.Name" />
                            </picture>
                            <span class="destination-image-title">@d.Name</span>
                        </a>
                    </div>
                </div>
            }
            @if(!Model.Featured.Any())
            {
                <div class="col-12">
                    <div class="alert alert-light border">Henüz öne çıkan destinasyon bulunmuyor.</div>
                </div>
            }
        </div>
    </div>

    <div id="categories-list" class="home-tab-panel d-none">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body py-3">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-12 col-md-6">
                        <select id="categorySelect" name="Category" class="form-select">
                            <option value="">Kategori seçiniz</option>
                            @foreach (var category in categoryOptions)
                            {
                                <option value="@category" selected="@(selectedCategory == category ? "selected" : null)">@category</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-auto">
                        <button type="submit" class="btn btn-soft-yellow-action">Sorgula</button>
                    </div>
                </form>
            </div>
        </div>

        @{
            var categoryResults = string.IsNullOrWhiteSpace(selectedCategory)
                ? Model.Latest
                : Model.Latest.Where(d => (d.Attractions ?? new List<Roma.Models.Attraction>())
                    .Any(a => string.Equals((a.Category ?? string.Empty).Trim(), selectedCategory.Trim(), StringComparison.OrdinalIgnoreCase)))
                    .ToList();
        }

        @if (categoryResults.Any())
        {
            <div class="row g-2" id="categoryResultsGrid">
                @for (var ci = 0; ci < categoryResults.Count; ci++)
                {
                    var cd = categoryResults[ci];
                    var cimg = Model.GetSmallestImageUrl(cd.Images.FirstOrDefault()?.Url);
                    if (string.IsNullOrWhiteSpace(cimg)) { cimg = "/images/italya.jpg"; }
                    var csrcset = Model.BuildSrcSet(cimg);
                    var cIsPriorityImage = ci < 2;
                    var hiddenClass = ci >= 6 ? "d-none" : string.Empty;
                    <div class="col-12 col-sm-6 col-md-4 mb-2 js-destination-item @hiddenClass">
                        <div class="card h-100 shadow-sm destination-card border-0 reveal-up">
                            <a class="destination-image-link" asp-page="/Destinations/PhotoDetails" asp-route-id="@cd.Id">
                                <picture>
                                    @if (!string.IsNullOrEmpty(csrcset))
                                    {
                                        <source srcset="@csrcset" sizes="(max-width: 576px) 100vw, (max-width: 992px) 50vw, 33vw" type="image/webp" />
                                    }
                                    <img class="card-img-top destination-image" src="@cimg" srcset="@csrcset" sizes="(max-width: 576px) 100vw, (max-width: 992px) 50vw, 33vw" loading="@(cIsPriorityImage ? "eager" : "lazy")" fetchpriority="@(cIsPriorityImage ? "high" : "auto")" decoding="async" alt="@cd.Name" />
                                </picture>
                                <span class="destination-image-title">@cd.Name</span>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-light border">Seçilen kategori için sonuç bulunamadı.</div>
        }
    </div>

    <div id="latest-list" class="home-tab-panel">
        <div class="row g-2">
            @for (var i = 0; i < Model.Latest.Count; i++)
            {
                var d = Model.Latest[i];
                var img = Model.GetSmallestImageUrl(d.Images.FirstOrDefault()?.Url);
                if (string.IsNullOrWhiteSpace(img)) { img = "/images/italya.jpg"; }
                var srcset = Model.BuildSrcSet(img);
                var isPriorityImage = i < 2;
                var hiddenClass = i >= 6 ? "d-none" : string.Empty;
                <div class="col-12 col-sm-6 col-md-4 mb-2 js-destination-item @hiddenClass">
                    <div class="card h-100 shadow-sm destination-card border-0 reveal-up">
                        <a class="destination-image-link" asp-page="/Destinations/PhotoDetails" asp-route-id="@d.Id">
                            <picture>
                                @if(!string.IsNullOrEmpty(srcset)){
                                    <source srcset="@srcset" sizes="(max-width: 576px) 100vw, (max-width: 992px) 50vw, 33vw" type="image/webp" />
                                }
                                <img class="card-img-top destination-image" src="@img" srcset="@srcset" sizes="(max-width: 576px) 100vw, (max-width: 992px) 50vw, 33vw" loading="@(isPriorityImage ? "eager" : "lazy")" fetchpriority="@(isPriorityImage ? "high" : "auto")" decoding="async" alt="@d.Name" />
                            </picture>
                            <span class="destination-image-title">@d.Name</span>
                        </a>
                    </div>
                </div>
            }
            @if(!Model.Latest.Any())
            {
                <div class="col-12">
                    <div class="alert alert-light border">Henüz yeni destinasyon bulunmuyor.</div>
                </div>
            }
        </div>
    </div>

    <div class="text-center mt-2 mb-3">
        <button type="button" id="bottomLoadMoreBtn" class="btn btn-soft-yellow-action d-none" data-step="6">
            +6 Daha Fazla
        </button>
    </div>

    <div id="homeEndActions" class="d-flex flex-wrap justify-content-center gap-2 mt-3 mb-2 d-none">
        <a class="btn btn-soft-yellow-action" href="javascript:history.back()">Geri</a>
        <a class="btn btn-soft-yellow-action" asp-page="/Index">Ana Sayfa</a>
    </div>
</section>

</div>

@section Scripts {
    <script>
        (function(){
            var featuredPanel = document.getElementById('featured-list');
            var tabButtons = document.querySelectorAll('.js-explore-tabs .home-tab-btn');
            var heroScrollButtons = document.querySelectorAll('.js-hero-scroll');
            var heroFeaturedStrip = document.getElementById('heroFeaturedStrip');
            var heroSliderArea = document.getElementById('heroSliderArea');
            var homeEndActions = document.getElementById('homeEndActions');
            var bottomLoadMoreBtn = document.getElementById('bottomLoadMoreBtn');
            var destinationLinks = document.querySelectorAll('.destination-image-link');
            var selectedCategory = '@selectedCategory';

            function hydrateFeaturedDeferredMedia() {
                if (!featuredPanel) return;

                var deferredImages = featuredPanel.querySelectorAll('img.js-featured-deferred');
                deferredImages.forEach(function (img) {
                    var dataSrc = img.getAttribute('data-src');
                    var dataSrcSet = img.getAttribute('data-srcset');
                    var dataSizes = img.getAttribute('data-sizes');

                    if (dataSrc) {
                        img.setAttribute('src', dataSrc);
                        img.removeAttribute('data-src');
                    }

                    if (dataSrcSet) {
                        img.setAttribute('srcset', dataSrcSet);
                        img.removeAttribute('data-srcset');
                    }

                    if (dataSizes) {
                        img.setAttribute('sizes', dataSizes);
                        img.removeAttribute('data-sizes');
                    }

                    img.classList.remove('js-featured-deferred');
                });

                var deferredSources = featuredPanel.querySelectorAll('source.js-featured-deferred-source');
                deferredSources.forEach(function (source) {
                    var dataSrcSet = source.getAttribute('data-srcset');
                    var dataSizes = source.getAttribute('data-sizes');

                    if (dataSrcSet) {
                        source.setAttribute('srcset', dataSrcSet);
                        source.removeAttribute('data-srcset');
                    }

                    if (dataSizes) {
                        source.setAttribute('sizes', dataSizes);
                        source.removeAttribute('data-sizes');
                    }

                    source.classList.remove('js-featured-deferred-source');
                });
            }

            function scheduleFeaturedBackgroundLoad() {
                if ('requestIdleCallback' in window) {
                    window.requestIdleCallback(function () {
                        hydrateFeaturedDeferredMedia();
                    }, { timeout: 1500 });
                    return;
                }

                setTimeout(hydrateFeaturedDeferredMedia, 300);
            }

            function getActivePanel() {
                return document.querySelector('.home-tab-panel:not(.d-none)');
            }

            function updateLoadMoreButtons() {
                updateEndActions();
            }

            function updateEndActions() {
                if (!homeEndActions) return;

                var panel = getActivePanel();
                if (!panel) {
                    homeEndActions.classList.add('d-none');
                    return;
                }

                var totalItems = panel.querySelectorAll('.js-destination-item').length;
                var hiddenItems = panel.querySelectorAll('.js-destination-item.d-none:not(.js-passed-item)').length;

                if (totalItems > 0 && hiddenItems === 0) {
                    homeEndActions.classList.remove('d-none');
                } else {
                    homeEndActions.classList.add('d-none');
                }

                if (!bottomLoadMoreBtn) return;

                if (hiddenItems > 0) {
                    var step = parseInt(bottomLoadMoreBtn.getAttribute('data-step') || '6', 10);
                    var revealCount = Math.min(step, hiddenItems);
                    bottomLoadMoreBtn.textContent = "+" + revealCount + " Daha Fazla";
                    bottomLoadMoreBtn.classList.remove('d-none');
                } else {
                    bottomLoadMoreBtn.classList.add('d-none');
                }
            }

            if (bottomLoadMoreBtn) {
                bottomLoadMoreBtn.addEventListener('click', function () {
                    var panel = getActivePanel();
                    if (!panel) return;

                    var step = parseInt(bottomLoadMoreBtn.getAttribute('data-step') || '6', 10);
                    var visibleItems = panel.querySelectorAll('.js-destination-item:not(.d-none):not(.js-passed-item)');
                    var hiddenItems = panel.querySelectorAll('.js-destination-item.d-none:not(.js-passed-item)');

                    if (!hiddenItems.length) {
                        updateLoadMoreButtons();
                        return;
                    }

                    visibleItems.forEach(function (item) {
                        item.classList.add('js-passed-item');
                        item.classList.add('d-none');
                    });

                    for (var i = 0; i < Math.min(step, hiddenItems.length); i++) {
                        hiddenItems[i].classList.remove('d-none');
                    }

                    if (heroSliderArea) {
                        heroSliderArea.classList.add('d-none');
                    }

                    updateLoadMoreButtons();
                });
            }

            destinationLinks.forEach(function (link) {
                link.addEventListener('click', function () {
                    if (heroSliderArea) {
                        heroSliderArea.classList.add('d-none');
                    }
                });
            });

            tabButtons.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    tabButtons.forEach(function (x) {
                        x.classList.remove('active');
                        x.setAttribute('aria-selected', 'false');
                    });

                    document.querySelectorAll('.home-tab-panel').forEach(function (panel) {
                        panel.classList.add('d-none');
                    });

                    var targetId = tab.getAttribute('data-target');
                    document.querySelectorAll('.js-explore-tabs .home-tab-btn[data-target="' + targetId + '"]').forEach(function (btn) {
                        btn.classList.add('active');
                        btn.setAttribute('aria-selected', 'true');
                    });

                    var target = document.getElementById(targetId);
                    if (target) {
                        target.classList.remove('d-none');
                    }

                    if (heroSliderArea && (targetId === 'featured-list' || targetId === 'latest-list' || targetId === 'categories-list')) {
                        heroSliderArea.classList.add('d-none');
                    }

                    updateLoadMoreButtons();
                });
            });

            heroScrollButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    if (!heroFeaturedStrip) return;

                    var direction = button.getAttribute('data-direction') === 'left' ? -1 : 1;
                    var scrollAmount = Math.max(220, Math.round(heroFeaturedStrip.clientWidth * 0.6));

                    heroFeaturedStrip.scrollBy({
                        left: direction * scrollAmount,
                        behavior: 'smooth'
                    });
                });
            });

            updateLoadMoreButtons();
            scheduleFeaturedBackgroundLoad();
            if (selectedCategory) {
                var categoryTab = document.querySelector('.home-tab-btn[data-target="categories-list"]');
                if (categoryTab) {
                    categoryTab.click();
                }
            }

            var hasSeenSplash = false;
            try {
                hasSeenSplash = localStorage.getItem('homeSplashSeen') === '1';
            } catch {
            }

            if (hasSeenSplash) {
                var existingSplash = document.getElementById('homeSplash');
                if (existingSplash) {
                    existingSplash.remove();
                }
                return;
            }

            try {
                localStorage.setItem('homeSplashSeen', '1');
            } catch {
            }

            var splashHidden = false;

            function hideSplashWithDelay() {
                if (splashHidden) return;

                var splash = document.getElementById('homeSplash');
                if (!splash) return;

                splashHidden = true;
                setTimeout(function () {
                    splash.classList.add('is-hidden');
                    setTimeout(function () { splash.remove(); }, 450);
                }, 6000);
            }

            if (document.readyState === 'complete' || document.readyState === 'interactive') {
                hideSplashWithDelay();
            } else {
                document.addEventListener('DOMContentLoaded', hideSplashWithDelay, { once: true });
                window.addEventListener('load', hideSplashWithDelay, { once: true });
            }

            setTimeout(hideSplashWithDelay, 6000);

        })();
    </script>
}
