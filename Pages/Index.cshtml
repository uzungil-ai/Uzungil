@page
@model Roma.Pages.IndexModel
@{
    ViewData["Title"] = "Fotografia ile - Keşfet";
    var firstFeatured = Model.Featured.FirstOrDefault();
    var firstFeaturedImage = firstFeatured?.Images.FirstOrDefault()?.Url ?? "/images/italya.jpg";
    var firstFeaturedName = firstFeatured?.Name ?? "Fotografia";
}

@section Head {
    <link rel="preload" as="image" href="@firstFeaturedImage" fetchpriority="high" />

    <style>
        #homeSplash {
            position: fixed;
            inset: 0;
            z-index: 2000;
            background: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 1;
            visibility: visible;
            transition: opacity .35s ease, visibility .35s ease;
        }

        #homeSplash.is-hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        #homeSplash img {
            width: 100vw;
            height: 100vh;
            object-fit: cover;
        }

        #homeSplash .home-splash-title {
            position: absolute;
            left: 50%;
            top: calc(50% - 7.2rem);
            transform: translate(-50%, -50%);
            color: #b45309;
            font-size: clamp(4rem, 10.4vw, 5.6rem);
            text-align: center;
            text-shadow: 0 3px 10px rgba(0, 0, 0, .75);
            font-weight: 700;
            margin: 0;
        }

        #homeSplash .home-splash-subtitle {
            position: absolute;
            left: 50%;
            top: calc(50% - 3.8rem);
            transform: translateX(-50%);
            color: #b45309;
            font-size: clamp(4rem, 10.4vw, 5.6rem);
            text-align: center;
            text-shadow: 0 2px 6px rgba(0, 0, 0, .45);
            font-weight: 700;
            margin: 0;
        }

        #homeSplash .home-splash-search {
            position: absolute;
            left: 50%;
            top: calc(50% + 4.5rem);
            transform: translateX(-50%);
            width: min(92vw, 660px);
            display: flex;
            gap: .5rem;
            padding: .5rem;
            border-radius: 999px;
            background: rgba(15, 23, 42, .45);
            border: 1px solid rgba(255,255,255,.35);
            backdrop-filter: blur(4px);
        }

        #homeSplash .home-splash-search .form-control {
            border-radius: 999px;
            flex: 1 1 auto;
            min-width: 0;
        }

        #homeSplash .home-splash-search .btn {
            border-radius: 999px;
            white-space: nowrap;
            flex: 0 0 auto;
        }

        #homeSplash .home-splash-actions {
            position: absolute;
            left: 50%;
            bottom: 9vh;
            transform: translateX(-50%);
            width: min(92vw, 980px);
            display: flex;
            flex-wrap: wrap;
            gap: .6rem;
            justify-content: center;
        }

        #homeSplash .splash-cta {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: .6rem .95rem;
            border-radius: 999px;
            color: #fff;
            text-decoration: none;
            font-weight: 700;
            letter-spacing: .01em;
            border: 1px solid rgba(255,255,255,.45);
            backdrop-filter: blur(3px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, .28);
        }

        #homeSplash .splash-cta-chat { background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); }
        #homeSplash .splash-cta-ai { background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%); }
        #homeSplash .splash-cta-plan { background: linear-gradient(135deg, #059669 0%, #047857 100%); }
        #homeSplash .splash-cta-review { background: linear-gradient(135deg, #c2410c 0%, #9a3412 100%); }
        #homeSplash .splash-cta-brand { background: var(--navbar-theme-gradient); }
        #homeSplash .splash-cta-whatsapp { background: linear-gradient(135deg, #25d366 0%, #128c7e 100%); }
        #homeSplash .splash-cta-about { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); }

        .js-destination-item {
            content-visibility: auto;
            contain-intrinsic-size: 320px;
        }

        @@media (max-width: 768px) {
            #homeSplash {
                background: transparent;
            }

            #homeSplash img {
                width: auto;
                height: auto;
                max-width: none;
                max-height: none;
                object-fit: contain;
                transform: scale(2);
                transform-origin: center;
            }

            #homeSplash .home-splash-subtitle {
                top: calc(50% - 2.6rem);
            }

            #homeSplash .home-splash-title {
                top: calc(50% - 5.6rem);
            }

            #homeSplash .home-splash-search {
                top: calc(50% + 3.8rem);
                width: min(calc(94vw * 0.8), 448px);
                padding: .4rem;
            }

            #homeSplash .home-splash-search .form-control:focus {
                width: 100%;
                transform: none;
            }

            #homeSplash .home-splash-actions {
                bottom: 7vh;
                gap: .45rem;
            }

            #homeSplash .splash-cta {
                font-size: .9rem;
                padding: .5rem .8rem;
            }
        }
    </style>
}

<div id="homeSplash" aria-hidden="true">
    <img src="@firstFeaturedImage" alt="@firstFeaturedName" loading="eager" fetchpriority="high" decoding="async" />
    <form method="get" class="home-splash-search" aria-label="Ana sayfa arama">
        <input name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Örn: Kapadokya veya Türkiye" />
        <button type="submit" class="btn btn-warning text-dark fw-semibold">Ara</button>
    </form>
    <div class="home-splash-actions" aria-label="Hızlı işlemler">
        <a class="splash-cta splash-cta-chat" href="/Chat">Nereye gitmek istersiniz</a>
        <a class="splash-cta splash-cta-ai" href="/OpenAiSoruCevap">Yapay zekaya sor</a>
        <a class="splash-cta splash-cta-plan" href="/SeyahatPlanla">Seyahat planla</a>
        <a class="splash-cta splash-cta-whatsapp" href="https://wa.me/?text=Fotografia%20-%20https%3A%2F%2Ffotografia.com.tr" target="_blank" rel="noopener noreferrer">What-up ile paylaş</a>
        <a class="splash-cta splash-cta-about" asp-controller="Home" asp-action="Hakkında">Hakkında</a>
    </div>
</div>

<section class="container destination-top-search-wrap" aria-label="Destinasyon arama">
    <form method="get" class="destination-top-search-form">
        <div class="hero-search-grid destination-top-search-grid">
            <div class="hero-search-field">
                <input id="hero-search" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Örn: Kapadokya veya Türkiye" />
            </div>
            <div class="hero-search-action destination-top-search-action">
                <button type="submit" class="home-tab-btn home-action-link home-action-yellow" aria-label="Ara">
                    Ara
                </button>
            </div>
        </div>
    </form>
</section>

<div class="home-under-hero-bg">
<section class="container hero-search-slider-wrap">
    <div class="hero-search-card shadow-sm">
        <div class="home-tabs home-actions mb-4" aria-label="Hızlı işlemler">
            <button type="button" class="home-tab-btn home-action-link active home-navbar-theme-btn" data-bs-toggle="modal" data-bs-target="#subscribeModal">Abone Ol</button>
            <a class="home-tab-btn home-action-link home-action-yellow" href="/Chat">Chat</a>
            <a class="home-tab-btn home-action-link home-action-yellow" href="/OpenAiSoruCevap">Aİ-Sor</a>
                    <a class="home-tab-btn home-action-link home-action-yellow" href="/SeyahatPlanla">Seyahat Planı</a>
        </div>

        <div class="hero-featured-strip-wrap mb-4">
            <button type="button" class="btn btn-sm btn-outline-primary hero-scroll-btn hero-scroll-btn-left js-hero-scroll" data-direction="left" aria-label="Sola kaydır">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path fill-rule="evenodd" d="M8.354 1.646a.5.5 0 0 1 0 .708L2.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0" />
                    <path fill-rule="evenodd" d="M12.354 1.646a.5.5 0 0 1 0 .708L6.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0" />
                </svg>
            </button>

            <div id="heroFeaturedStrip" class="hero-featured-strip" role="region" aria-label="Öne çıkan destinasyon görselleri">
                @if (Model.Featured.Any())
                {
                    @for (var i = 0; i < Math.Min(8, Model.Featured.Count); i++)
                    {
                        var d = Model.Featured[i];
                        var img = d.Images.FirstOrDefault()?.Url ?? "/images/italya.jpg";
                        var isFirstSlideImage = i == 0;
                        <a class="hero-featured-item" asp-page="/Destinations/PhotoDetails" asp-route-id="@d.Id" aria-label="@d.Name detaylarını görüntüle">
                            <img src="@img"
                                 alt="@d.Name"
                                 loading="@(isFirstSlideImage ? "eager" : "lazy")"
                                 fetchpriority="@(isFirstSlideImage ? "high" : "auto")"
                                 decoding="async" />
                            <span>@d.Name</span>
                        </a>
                    }
                }
                else
                {
                    <div class="alert alert-light border mb-0 w-100">Henüz öne çıkan içerik bulunmuyor.</div>
                }
            </div>

            <button type="button" class="btn btn-sm btn-outline-primary hero-scroll-btn hero-scroll-btn-right js-hero-scroll" data-direction="right" aria-label="Sağa kaydır">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path fill-rule="evenodd" d="M3.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L9.293 8 3.646 2.354a.5.5 0 0 1 0-.708" />
                    <path fill-rule="evenodd" d="M7.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L13.293 8 7.646 2.354a.5.5 0 0 1 0-.708" />
                </svg>
            </button>
        </div>

    </div>
</section>

<section id="explore" class="container mt-0 mb-5 home-explore-section">

    <div class="home-tabs mb-3" role="tablist" aria-label="Destinasyon sekmeleri">
        <button type="button" class="home-tab-btn active home-navbar-theme-btn" data-target="featured-list" aria-selected="true">Öne Çıkanlar</button>
        <button type="button" class="home-tab-btn" data-target="latest-list" aria-selected="false">En Yeniler</button>
        <a class="home-tab-btn home-action-yellow" asp-controller="Reviews" asp-action="Index">Yorumlar</a>
    </div>

    <div id="featured-list" class="home-tab-panel">
        <div class="row g-2">
            @for (var i = 0; i < Model.Featured.Count; i++)
            {
                var d = Model.Featured[i];
                var img = d.Images.FirstOrDefault()?.Url ?? "/images/italya.jpg";
                var srcset = Model.BuildSrcSet(img);
                var isPriorityImage = i < 2;
                var hiddenClass = i >= 6 ? "d-none" : string.Empty;
                <div class="col-12 col-sm-6 col-md-4 mb-2 js-destination-item @hiddenClass">
                    <div class="card h-100 shadow-sm destination-card border-0 reveal-up">
                        <a class="destination-image-link" asp-page="/Destinations/PhotoDetails" asp-route-id="@d.Id">
                            <picture>
                                @if(!string.IsNullOrEmpty(srcset)){
                                    <source srcset="@srcset" type="image/webp" />
                                }
                                <img class="card-img-top destination-image" src="@img" loading="@(isPriorityImage ? "eager" : "lazy")" fetchpriority="@(isPriorityImage ? "high" : "auto")" decoding="async" alt="@d.Name" />
                            </picture>
                            <span class="destination-image-title">@d.Name</span>
                        </a>
                    </div>
                </div>
            }
            @if(!Model.Featured.Any())
            {
                <div class="col-12">
                    <div class="alert alert-light border">Henüz öne çıkan destinasyon bulunmuyor.</div>
                </div>
            }
        </div>
        @if (Model.Featured.Count > 6)
        {
            <div class="text-center mt-3 mb-3">
                <button type="button" id="featuredLoadMore" class="btn js-load-more btn-navbar-theme" data-target-panel="featured-list" data-step="6">
                    Daha Fazla
                </button>
            </div>
        }
    </div>

    <div id="latest-list" class="home-tab-panel d-none">
        <div class="row g-2">
            @for (var i = 0; i < Model.Latest.Count; i++)
            {
                var d = Model.Latest[i];
                var img = d.Images.FirstOrDefault()?.Url ?? "/images/italya.jpg";
                var srcset = Model.BuildSrcSet(img);
                var isPriorityImage = i < 2;
                var hiddenClass = i >= 6 ? "d-none" : string.Empty;
                <div class="col-12 col-sm-6 col-md-4 mb-2 js-destination-item @hiddenClass">
                    <div class="card h-100 shadow-sm destination-card border-0 reveal-up">
                        <a class="destination-image-link" asp-page="/Destinations/PhotoDetails" asp-route-id="@d.Id">
                            <picture>
                                @if(!string.IsNullOrEmpty(srcset)){
                                    <source srcset="@srcset" type="image/webp" />
                                }
                                <img class="card-img-top destination-image" src="@img" loading="@(isPriorityImage ? "eager" : "lazy")" fetchpriority="@(isPriorityImage ? "high" : "auto")" decoding="async" alt="@d.Name" />
                            </picture>
                            <span class="destination-image-title">@d.Name</span>
                        </a>
                    </div>
                </div>
            }
            @if(!Model.Latest.Any())
            {
                <div class="col-12">
                    <div class="alert alert-light border">Henüz yeni destinasyon bulunmuyor.</div>
                </div>
            }
        </div>
    </div>

    <div id="all-list" class="home-tab-panel d-none">
        <div class="row g-2">
            @for (var i = 0; i < Model.Featured.Count; i++)
            {
                var d = Model.Featured[i];
                var img = d.Images.FirstOrDefault()?.Url ?? "/images/italya.jpg";
                var srcset = Model.BuildSrcSet(img);
                var hiddenClass = i >= 6 ? "d-none" : string.Empty;
                <div class="col-12 col-sm-6 col-md-4 mb-2 js-destination-item @hiddenClass">
                    <div class="card h-100 shadow-sm destination-card border-0 reveal-up">
                        <a class="destination-image-link" asp-page="/Destinations/PhotoDetails" asp-route-id="@d.Id">
                            <picture>
                                @if(!string.IsNullOrEmpty(srcset)){
                                    <source srcset="@srcset" type="image/webp" />
                                }
                                <img class="card-img-top destination-image" src="@img" loading="lazy" decoding="async" alt="@d.Name" />
                            </picture>
                            <span class="destination-image-title">@d.Name</span>
                        </a>
                    </div>
                </div>
            }
            @if(!Model.Featured.Any())
            {
                <div class="col-12">
                    <div class="alert alert-light border">Henüz destinasyon bulunmuyor.</div>
                </div>
            }
        </div>
        @if (Model.Latest.Count > 6)
        {
            <div class="text-center mt-3 mb-3">
                <button type="button" id="latestLoadMore" class="btn js-load-more btn-navbar-theme" data-target-panel="latest-list" data-step="6">
                    Daha Fazla
                </button>
            </div>
        }
    </div>

    <div id="homeEndActions" class="d-flex flex-wrap justify-content-center gap-2 mt-3 mb-2 d-none">
        <a class="btn btn-navbar-yellow-theme" href="javascript:history.back()">Geri</a>
        <a class="btn btn-navbar-theme" asp-page="/Index">Home</a>
    </div>
</section>

</div>

@section Scripts {
    <script>
        (function(){
            var tabButtons = document.querySelectorAll('.home-tabs[role="tablist"] .home-tab-btn');
            var loadMoreButtons = document.querySelectorAll('.js-load-more[data-target-panel]');
            var heroScrollButtons = document.querySelectorAll('.js-hero-scroll');
            var heroFeaturedStrip = document.getElementById('heroFeaturedStrip');
            var homeEndActions = document.getElementById('homeEndActions');

            function getActivePanel() {
                return document.querySelector('.home-tab-panel:not(.d-none)');
            }

            function updateLoadMoreButtons() {
                loadMoreButtons.forEach(function (button) {
                    var panelId = button.getAttribute('data-target-panel');
                    var panel = panelId ? document.getElementById(panelId) : null;

                    if (!panel || panel.classList.contains('d-none')) {
                        button.classList.add('d-none');
                        return;
                    }

                    var hiddenItems = panel.querySelectorAll('.js-destination-item.d-none');
                    if (hiddenItems.length === 0) {
                        button.classList.add('d-none');
                    } else {
                        button.classList.remove('d-none');
                    }
                });

                updateEndActions();
            }

            function updateEndActions() {
                if (!homeEndActions) return;

                var panel = getActivePanel();
                if (!panel) {
                    homeEndActions.classList.add('d-none');
                    return;
                }

                var totalItems = panel.querySelectorAll('.js-destination-item').length;
                var hiddenItems = panel.querySelectorAll('.js-destination-item.d-none').length;

                if (totalItems > 0 && hiddenItems === 0) {
                    homeEndActions.classList.remove('d-none');
                } else {
                    homeEndActions.classList.add('d-none');
                }
            }

            loadMoreButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    var panelId = button.getAttribute('data-target-panel');
                    var panel = panelId ? document.getElementById(panelId) : null;
                    if (!panel) return;

                    var step = parseInt(button.getAttribute('data-step') || '6', 10);
                    var hiddenItems = panel.querySelectorAll('.js-destination-item.d-none');
                    for (var i = 0; i < Math.min(step, hiddenItems.length); i++) {
                        hiddenItems[i].classList.remove('d-none');
                    }

                    updateLoadMoreButtons();
                });
            });

            tabButtons.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    tabButtons.forEach(function (x) {
                        x.classList.remove('active');
                        x.setAttribute('aria-selected', 'false');
                    });

                    document.querySelectorAll('.home-tab-panel').forEach(function (panel) {
                        panel.classList.add('d-none');
                    });

                    tab.classList.add('active');
                    tab.setAttribute('aria-selected', 'true');

                    var targetId = tab.getAttribute('data-target');
                    var target = document.getElementById(targetId);
                    if (target) {
                        target.classList.remove('d-none');
                    }

                    updateLoadMoreButtons();
                });
            });

            heroScrollButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    if (!heroFeaturedStrip) return;

                    var direction = button.getAttribute('data-direction') === 'left' ? -1 : 1;
                    var scrollAmount = Math.max(220, Math.round(heroFeaturedStrip.clientWidth * 0.6));

                    heroFeaturedStrip.scrollBy({
                        left: direction * scrollAmount,
                        behavior: 'smooth'
                    });
                });
            });

            updateLoadMoreButtons();

            var splashHidden = false;

            function hideSplashWithDelay() {
                if (splashHidden) return;

                var splash = document.getElementById('homeSplash');
                if (!splash) return;

                splashHidden = true;
                setTimeout(function () {
                    splash.classList.add('is-hidden');
                    setTimeout(function () { splash.remove(); }, 450);
                }, 4000);
            }

            if (document.readyState === 'complete' || document.readyState === 'interactive') {
                hideSplashWithDelay();
            } else {
                document.addEventListener('DOMContentLoaded', hideSplashWithDelay, { once: true });
                window.addEventListener('load', hideSplashWithDelay, { once: true });
            }

            setTimeout(hideSplashWithDelay, 4000);

        })();
    </script>
}
