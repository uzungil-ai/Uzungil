@page
@model Roma.Pages.IndexModel
@{
    ViewData["Title"] = "Roma - Keşfet";
}

<section class="home-hero home-hero-turquoise py-5 py-lg-6 @(Model.HasActiveSearch ? "search-disabled-section" : string.Empty)" aria-disabled="@(Model.HasActiveSearch ? "true" : "false")">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-8 col-xl-7">
                <span class="badge rounded-pill text-bg-light mb-3">Yapay zeka destekli. Seyahat Planlama</span>
                <h1 class="display-5 fw-bold mb-3">Fotografia ile daha hızlı, daha net seyahat planı oluşturun</h1>
                <p class="lead mb-4">Öne çıkan destinasyonları görün, sohbet botundan öneri alın ve güncellemeleri takip edin.</p>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <a class="btn btn-light btn-lg hero-explore-btn" href="#explore">Destinasyonları Gör</a>
                    <a class="btn btn-outline-light btn-lg" href="/Chat">Sohbet Botu</a>
                    <a class="btn btn-warning text-dark btn-lg app-yellow-cta" href="/OpenAiSoruCevap">OpenAI Soru-Cevap</a>
                    <button type="button" class="btn btn-warning btn-lg app-yellow-cta" data-bs-toggle="modal" data-bs-target="#subscribeModal">Abone Ol</button>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <span class="hero-pill">Hızlı keşif</span>
                    <span class="hero-pill">Mobil uyumlu</span>
                    <span class="hero-pill">Canlı güncelleme</span>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="home-under-hero-bg">
<section class="container my-4 home-stats-section @(Model.HasActiveSearch ? "search-disabled-section" : string.Empty)" aria-disabled="@(Model.HasActiveSearch ? "true" : "false")">
    <div class="row g-3">
        <div class="col-sm-6 col-lg-3">
            <div class="quick-stat-box">
                <div class="small text-muted">Öne çıkan</div>
                <div class="h4 mb-0">@Model.Featured.Count</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="quick-stat-box">
                <div class="small text-muted">En yeni</div>
                <div class="h4 mb-0">@Model.Latest.Count</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="quick-stat-box">
                <div class="small text-muted">Yardım aracı</div>
                <div class="h6 mb-0">Sohbet Botu hazır</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="quick-stat-box">
                <div class="small text-muted">Hızlı işlem</div>
                <a href="/OpenAiSoruCevap" class="fw-semibold text-decoration-none">OpenAI ile soru sor →</a>
            </div>
        </div>
    </div>
</section>

<section id="explore" class="container my-5 home-explore-section">
    @* <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h2 class="mb-0 section-title" style="text-decoration-color:mediumblue">Destinasyonları keşfedin</h2>
        <span class="text-muted small">Öne çıkan: @Model.Featured.Count • Yeni: @Model.Latest.Count</span>
    </div> *@

    <form method="get" class="card border-0 shadow-sm mb-4 discover-filter-card">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-5">
                  <label for="name" class="form-label">Destinasyon Adı</label>
                    <input id="name" name="name" class="form-control" placeholder="Örn: Kapadokya" />
                </div>
                <div class="col-12 col-md-5">
                   <label for="country" class="form-label">Ülke</label>
                    <input id="country" name="country" class="form-control" placeholder="Örn: Türkiye" />
                </div>
                <div class="col-12 col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary btn-modern">Ara</button>
                </div>
            </div>
        </div>
    </form>

    <div class="home-tabs mb-4" role="tablist" aria-label="Destinasyon sekmeleri">
        <button type="button" class="home-tab-btn active" data-target="featured-list" aria-selected="true">Öne Çıkanlar</button>
        <button type="button" class="home-tab-btn" data-target="latest-list" aria-selected="false">En Yeniler</button>
    </div>

    <div id="featured-list" class="home-tab-panel">
        <div class="row">
            @for (var i = 0; i < Model.Featured.Count; i++)
            {
                var d = Model.Featured[i];
                var img = d.Images.FirstOrDefault()?.Url ?? "/images/italya.jpg";
                var srcset = Model.BuildSrcSet(img);
                var hiddenClass = i >= 9 ? "d-none" : string.Empty;
                <div class="col-12 col-sm-6 col-md-4 mb-4 js-destination-item @hiddenClass">
                    <div class="card h-100 shadow-sm destination-card border-0 reveal-up">
                        <a asp-page="/Destinations/PhotoDetails" asp-route-id="@d.Id">
                            <picture>
                                @if(!string.IsNullOrEmpty(srcset)){
                                    <source srcset="@srcset" type="image/webp" />
                                }
                                <img class="card-img-top destination-image" src="@img" loading="lazy" alt="@d.Name" />
                            </picture>
                        </a>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <h5 class="card-title mb-1">@d.Name</h5>
                                <span class="badge text-bg-light">@d.Country</span>
                            </div>
                            <p class="small text-muted mb-3">@((d.Description?.Length>120)?d.Description.Substring(0,120)+"...":d.Description)</p>
                            <a asp-page="/Destinations/PhotoDetails" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">Detayları Gör</a>
                        </div>
                    </div>
                </div>
            }
            @if(!Model.Featured.Any())
            {
                <div class="col-12">
                    <div class="alert alert-light border">Henüz öne çıkan destinasyon bulunmuyor.</div>
                </div>
            }
        </div>
        @if (Model.Featured.Count > 9)
        {
            <div class="text-center mb-3">
                <button type="button"
                        class="btn btn-outline-primary js-load-more"
                        data-panel-id="featured-list"
                        data-step="9">
                    Daha Fazla Göster
                </button>
            </div>
        }
    </div>

    <div id="latest-list" class="home-tab-panel d-none">
        <div class="row">
            @for (var i = 0; i < Model.Latest.Count; i++)
            {
                var d = Model.Latest[i];
                var img = d.Images.FirstOrDefault()?.Url ?? "/images/italya.jpg";
                var srcset = Model.BuildSrcSet(img);
                var hiddenClass = i >= 9 ? "d-none" : string.Empty;
                <div class="col-12 col-sm-6 col-md-4 mb-4 js-destination-item @hiddenClass">
                    <div class="card h-100 shadow-sm destination-card border-0 reveal-up">
                        <a asp-page="/Destinations/PhotoDetails" asp-route-id="@d.Id">
                            <picture>
                                @if(!string.IsNullOrEmpty(srcset)){
                                    <source srcset="@srcset" type="image/webp" />
                                }
                                <img class="card-img-top destination-image" src="@img" loading="lazy" alt="@d.Name" />
                            </picture>
                        </a>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <h5 class="card-title mb-1">@d.Name</h5>
                                <span class="badge text-bg-light">@d.Country</span>
                            </div>
                            <p class="small text-muted mb-3">@((d.Description?.Length>120)?d.Description.Substring(0,120)+"...":d.Description)</p>
                            <a asp-page="/Destinations/PhotoDetails" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">Detayları Gör</a>
                        </div>
                    </div>
                </div>
            }
            @if(!Model.Latest.Any())
            {
                <div class="col-12">
                    <div class="alert alert-light border">Henüz yeni destinasyon bulunmuyor.</div>
                </div>
            }
        </div>
        @if (Model.Latest.Count > 9)
        {
            <div class="text-center mb-3">
                <button type="button"
                        class="btn btn-outline-primary js-load-more"
                        data-panel-id="latest-list"
                        data-step="9">
                    Daha Fazla Göster
                </button>
            </div>
        }
    </div>
</section>

<section class="container pb-5">
    <div class="row g-3">
        <div class="col-md-4">
            <a href="#explore" class="text-decoration-none text-reset d-block h-100">
                <div class="feature-box feature-step-card h-100 reveal-up">
                    <div class="feature-step-icon" aria-hidden="true">🧭</div>
                    <h3 class="h6">1. Keşfet</h3>
                    <p class="mb-0 text-muted">Öne çıkan noktaları incele ve görsellerle hızlı karşılaştır.</p>
                    <span class="feature-step-link">Destinasyonları aç →</span>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Chat" class="text-decoration-none text-reset d-block h-100">
                <div class="feature-box feature-step-card h-100 reveal-up">
                    <div class="feature-step-icon" aria-hidden="true">🗺️</div>
                    <h3 class="h6">2. Planla</h3>
                    <p class="mb-0 text-muted">Sohbet botu ile tercihine göre öneri ve rota al.</p>
                    <span class="feature-step-link">Sohbet botunu aç →</span>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <button type="button" class="feature-box feature-step-card h-100 reveal-up text-start w-100 border-0" data-bs-toggle="modal" data-bs-target="#subscribeModal">
                <div class="feature-step-icon" aria-hidden="true">🔔</div>
                <h3 class="h6">3. Takip Et</h3>
                <p class="mb-0 text-muted">Bülten ile yeni destinasyonları ve güncellemeleri öğren.</p>
                <span class="feature-step-link">Bültene katıl →</span>
            </button>
        </div>
    </div>
</section>
</div>

@section Scripts {
    <script>
        (function(){
            var tabButtons = document.querySelectorAll('.home-tab-btn');
            var loadMoreButtons = document.querySelectorAll('.js-load-more');

            function updateLoadMoreButton(button) {
                var panelId = button.getAttribute('data-panel-id');
                var panel = panelId ? document.getElementById(panelId) : null;
                if (!panel) return;

                var hiddenItems = panel.querySelectorAll('.js-destination-item.d-none');
                if (hiddenItems.length === 0) {
                    button.classList.add('d-none');
                }
            }

            loadMoreButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    var panelId = button.getAttribute('data-panel-id');
                    var panel = panelId ? document.getElementById(panelId) : null;
                    if (!panel) return;

                    var step = parseInt(button.getAttribute('data-step') || '9', 10);
                    var hiddenItems = panel.querySelectorAll('.js-destination-item.d-none');
                    for (var i = 0; i < Math.min(step, hiddenItems.length); i++) {
                        hiddenItems[i].classList.remove('d-none');
                    }

                    updateLoadMoreButton(button);
                });

                updateLoadMoreButton(button);
            });

            tabButtons.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    tabButtons.forEach(function (x) {
                        x.classList.remove('active');
                        x.setAttribute('aria-selected', 'false');
                    });

                    document.querySelectorAll('.home-tab-panel').forEach(function (panel) {
                        panel.classList.add('d-none');
                    });

                    tab.classList.add('active');
                    tab.setAttribute('aria-selected', 'true');

                    var targetId = tab.getAttribute('data-target');
                    var target = document.getElementById(targetId);
                    if (target) {
                        target.classList.remove('d-none');
                    }
                });
            });

        })();
    </script>
}
