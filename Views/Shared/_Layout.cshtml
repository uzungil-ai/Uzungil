@{
    var showPendingReviewsPopup = User?.Identity?.IsAuthenticated == true
        && User.IsInRole("Admin")
        && string.Equals(TempData["ShowPendingReviewsPopup"]?.ToString(), "1", StringComparison.Ordinal);

    var currentPathAndQuery = Context.Request.Path + Context.Request.QueryString;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Roma</title>
    @RenderSection("Head", required: false)
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Roma.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Fotografia.com.tr</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Hakkında</a>
                        </li>
                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Yönetim</a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item" asp-page="/Admin/Destinations/Index">Destinasyonlar</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="DestinationImages" asp-action="Index">Fotograf Yönetimi</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="DestinationImages" asp-action="Create">Yeni Fotograf Ekle</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Subscribers" asp-action="Index">Aboneler</a></li>
                                     <li><a class="dropdown-item" asp-area="" asp-controller="BackgroundEmailSenders" asp-action="Index">Background Email Senders</a></li>
                                     <li><a class="dropdown-item" asp-area="" asp-controller="DemoChatServices" asp-action="Index">Demo Chat Services</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#subscribeModal">Abone Ol</button>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container layout-main-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (showPendingReviewsPopup)
    {
        @await Component.InvokeAsync("PendingReviewsPopup", new { currentPathAndQuery })
    }

    <div class="modal fade" id="subscribeModal" tabindex="-1" aria-labelledby="subscribeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5 mb-0" id="subscribeModalLabel">Yeni önerileri kaçırmayın</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">Bültene abone olun, yeni destinasyon ve içerik güncellemelerini e-posta ile alın.</p>
                    <form id="subscribeForm" method="post" asp-page="/Subscribe">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label for="subEmail" class="form-label">E-posta</label>
                            <input type="email" id="subEmail" name="Email" placeholder="ornek@mail.com" class="form-control" autocomplete="email" />
                        </div>
                        <div class="form-check mb-3">
                            <input type="checkbox" id="subConsent" name="Consent" class="form-check-input" />
                            <label class="form-check-label" for="subConsent">Bilgilendirme e-postaları almayı kabul ediyorum.</label>
                        </div>
                        <button type="button" id="subBtn" class="btn btn-primary w-100">Abone Ol</button>
                    </form>
                    <div id="subMessage" class="mt-2 small"></div>
                </div>
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Roma - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var btn = document.getElementById('subBtn');
            var email = document.getElementById('subEmail');
            var consent = document.getElementById('subConsent');
            var msg = document.getElementById('subMessage');
            var form = document.getElementById('subscribeForm');

            if (!btn || !email || !consent || !msg || !form) return;

            btn.addEventListener('click', function () {
                msg.textContent = '';
                if (!email.value) { msg.textContent = 'E-posta giriniz.'; return; }
                if (!consent.checked) { msg.textContent = 'Lütfen rıza veriniz.'; return; }

                var data = new FormData();
                data.append('Email', email.value);
                data.append('Consent', consent.checked ? 'true' : 'false');

                var tokenEl = form.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenEl) data.append('__RequestVerificationToken', tokenEl.value);

                btn.disabled = true; btn.textContent = 'Gönderiliyor...';

                fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: data
                }).then(async function (resp) {
                    var payload = null;
                    try { payload = await resp.json(); } catch {}

                    if (!resp.ok) {
                        msg.textContent = (payload && payload.message) ? payload.message : 'Abonelik işlemi başarısız oldu.';
                        return;
                    }

                    msg.textContent = (payload && payload.message) ? payload.message : 'Abonelik isteğiniz alındı. Lütfen e-postanızı kontrol edin.';
                    form.reset();
                }).catch(function () { msg.textContent = 'Hata oluştu.'; })
                    .finally(function () { btn.disabled = false; btn.textContent = 'Abone Ol'; });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
