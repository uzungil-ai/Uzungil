@{
    var showPendingReviewsPopup = User?.Identity?.IsAuthenticated == true
        && User.IsInRole("Admin");

    var currentPathAndQuery = Context.Request.Path + Context.Request.QueryString;
    var pageTitle = ViewData["Title"]?.ToString();
    var seoTitle = string.IsNullOrWhiteSpace(pageTitle) ? "Fotografia | Seyahat Rehberi" : $"{pageTitle} | Fotografia";
    var seoDescription = ViewData["MetaDescription"]?.ToString() ?? "Fotografia ile gezi rotaları, destinasyon önerileri ve seyahat ipuçlarını keşfedin.";
    var seoKeywords = ViewData["MetaKeywords"]?.ToString() ?? "seyahat, gezi rehberi, destinasyon, tatil, fotografia";
    var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@seoTitle</title>
    <meta name="description" content="@seoDescription" />
    <meta name="keywords" content="@seoKeywords" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:title" content="@seoTitle" />
    <meta property="og:description" content="@seoDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:locale" content="tr_TR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@seoTitle" />
    <meta name="twitter:description" content="@seoDescription" />
    @RenderSection("Head", required: false)
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Roma.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark navbar-turquoise border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand navbar-openai-text" asp-area="" asp-controller="Home" asp-action="Index">Fotografia</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link navbar-about-link" asp-area="" asp-controller="Home" asp-action="Hakkında">Hakkında</a>
                        </li>
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Subscribers" asp-action="Index">Abonelik</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Destinations" asp-action="Index">Index</a>
                            </li>
                        }
                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Admin/ContentEditor">Toplu Düzenleme</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container layout-main-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (showPendingReviewsPopup)
    {
        @await Component.InvokeAsync("PendingReviewsPopup", new { currentPathAndQuery })
    }

    <div class="modal fade" id="subscribeModal" tabindex="-1" aria-labelledby="subscribeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content subscribe-modal-card">
                <div class="modal-header">
                    <h2 class="modal-title h5 mb-0 subscribe-title-accent" id="subscribeModalLabel">Yeni önerileri kaçırmayın</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">E-posta ile siteye kayıt olun, yeni eklenen içeriklerden haberiniz olsun.</p>
                    <form id="subscribeForm" method="post" asp-page="/Subscribe">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <input type="email" id="subEmail" name="Email" placeholder="ornek@mail.com" class="form-control" autocomplete="email" maxlength="254" required />
                        </div>
                        <br />
                        <div class="form-check mb-3">
                            <input type="checkbox" id="subConsent" name="Consent" class="form-check-input" required />
                            <label class="form-check-label" for="subConsent">Bilgilendirme e-postaları almayı kabul ediyorum.</label>
                        </div>
                    </form>
                    <div id="subMessage" class="mt-2"></div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Kapat</button>
                    <button type="button" id="subBtn" class="btn btn-warning text-dark fw-semibold app-yellow-cta">Abone Ol</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="site-footer simple-footer mt-3">
        <div class="container py-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div class="small text-muted">Fotografia • Seyahat rehberi</div>
                <div class="d-flex align-items-center gap-3 flex-wrap justify-content-center">
                    <a asp-area="" asp-controller="Home" asp-action="Hakkında" class="simple-footer-link">Hakkında</a>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="simple-footer-link">Gizlilik</a>
                    <a href="mailto:info@fotografia.com.tr" class="simple-footer-link">İletişim</a>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#subscribeModal">Bültene Katıl</button>
                </div>
            </div>
            <hr class="my-2" />
            <div class="text-center small text-muted">
                &copy; @DateTime.UtcNow.Year Fotografia Tüm hakları saklıdır.
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var btn = document.getElementById('subBtn');
            var email = document.getElementById('subEmail');
            var consent = document.getElementById('subConsent');
            var msg = document.getElementById('subMessage');
            var form = document.getElementById('subscribeForm');

            if (!btn || !email || !consent || !msg || !form) return;

            function setMessage(text, type) {
                msg.textContent = text || '';
                msg.className = 'mt-2';
                if (!text) return;

                if (type === 'success') {
                    msg.classList.add('alert', 'alert-success', 'fw-bold', 'border-2', 'border-success', 'shadow-sm');
                } else if (type === 'error') {
                    msg.classList.add('alert', 'alert-danger');
                } else {
                    msg.classList.add('alert', 'alert-warning');
                }
            }

            function submitSubscription() {
                setMessage('', 'info');
                if (!email.value) { setMessage('E-posta giriniz.', 'error'); return; }
                if (!consent.checked) { setMessage('Lütfen rıza veriniz.', 'error'); return; }

                var data = new FormData();
                data.append('Email', email.value);
                data.append('Consent', consent.checked ? 'true' : 'false');

                var tokenEl = form.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenEl) data.append('__RequestVerificationToken', tokenEl.value);

                btn.disabled = true; btn.textContent = 'Gönderiliyor...';

                fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: data
                }).then(async function (resp) {
                    var payload = null;
                    try { payload = await resp.json(); } catch {}

                    if (!resp.ok) {
                        setMessage((payload && payload.message) ? payload.message : 'Abonelik işlemi başarısız oldu.', 'error');
                        return;
                    }

                    setMessage((payload && payload.message) ? payload.message : 'Abonelik isteğiniz alındı. Lütfen e-postanızı kontrol edin.', 'success');
                    form.reset();
                }).catch(function () { setMessage('Hata oluştu.', 'error'); })
                    .finally(function () { btn.disabled = false; btn.textContent = 'Abone Ol'; });
            }

            btn.addEventListener('click', function () {
                submitSubscription();
            });

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                submitSubscription();
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
