@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<h1 class="text-danger">Bir hata oluştu.</h1>
<h2 class="text-danger">İsteğiniz işlenirken beklenmeyen bir sorun oluştu.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>İstek Kimliği:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>
    Sorun devam ederse bu istek kimliği ile sistem yöneticinize başvurun.
</p>
