@{
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = isAuthenticated && User.IsInRole("Admin");
    var userName = User?.Identity?.Name ?? "Kullanıcı";
}
<ul class="navbar-nav">
    @if (isAuthenticated)
    {
        @if (!isAdmin)
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @userName!</a>
            </li>
        }

        <li class="nav-item">
            <a class="nav-link navbar-openai-text navbar-icon-link" asp-area="" asp-controller="Home" asp-action="Index" title="ChatAI Ana Sayfa" aria-label="ChatAI Ana Sayfa">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M14 1a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4.414L1 15.414V2a1 1 0 0 1 1-1zM2 2v11l2-2h10V2z" />
                    <path d="M3 3h10v1H3zm0 2h10v1H3zm0 2h7v1H3z" />
                </svg>
                <span class="visually-hidden">ChatAI Ana Sayfa</span>
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark" asp-page="/Account/EnableAuthenticator">2FA</a>
        </li>

        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li> 
    }
    else
    {
       @*  <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li> *@
        <li class="nav-item">
            <a class="nav-link text-dark navbar-icon-link" asp-area="" asp-page="/Account/Login" title="Login" aria-label="Login">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M10 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0" />
                    <path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
                </svg>
                <span class="visually-hidden">Login</span>
            </a>
        </li>
    }
</ul>
