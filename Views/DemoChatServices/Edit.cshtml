@model Roma.Services.DemoChatService

@{
    ViewData["Title"] = "Edit";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h1 class="h5 mb-0">Demo Chat Service</h1>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="Input" class="control-label"></label>
                <input asp-for="Input" class="form-control" />
                <span asp-validation-for="Input" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SessionId" class="control-label"></label>
                <input asp-for="SessionId" class="form-control" />
                <span asp-validation-for="SessionId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Reply" class="control-label"></label>
                <textarea asp-for="Reply" class="form-control"></textarea>
                <span asp-validation-for="Reply" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CreatedAt" class="control-label"></label>
                <input asp-for="CreatedAt" class="form-control" />
                <span asp-validation-for="CreatedAt" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2 mt-3">
                <input type="submit" value="Save" class="btn btn-dark" />
                <a class="btn btn-outline-dark" asp-action="Index">Back to List</a>
            </div>
        </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
