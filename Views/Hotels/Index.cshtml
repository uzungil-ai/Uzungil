@model IEnumerable<Roma.Models.Hotel>

@{
    ViewData["Title"] = "Hotels";
}

<h1>Hotels</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Destination</th>
            <th>Address</th>
            <th>Phone</th>
            <th>Price From</th>
            <th>Price To</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Destination?.Name</td>
            <td>@item.Address</td>
            <td>@item.Phone</td>
            <td>@item.PriceFrom</td>
            <td>@item.PriceTo</td>
            <td>
                <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.Id">Details</a>
                <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
