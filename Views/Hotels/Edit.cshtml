@model Roma.Models.Hotel

@{
    ViewData["Title"] = "Edit Hotel";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h1 class="h5 mb-0">Edit Hotel</h1>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DestinationId">Destination</label>
                        <select asp-for="DestinationId" class="form-control" asp-items="ViewBag.DestinationId"></select>
                        <span asp-validation-for="DestinationId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address"></label>
                        <input asp-for="Address" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone"></label>
                        <input asp-for="Phone" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Website"></label>
                        <input asp-for="Website" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="PriceFrom"></label>
                        <input asp-for="PriceFrom" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="PriceTo"></label>
                        <input asp-for="PriceTo" class="form-control" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark">Save</button>
                        <a asp-action="Index" class="btn btn-outline-dark">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
