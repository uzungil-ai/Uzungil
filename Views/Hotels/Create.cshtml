@model Roma.Models.Hotel

@{
    ViewData["Title"] = "Create Hotel";
}

<h1>Create Hotel</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    @if (TempData["ModelErrors"] != null)
    {
        <div class="alert alert-danger">@TempData["ModelErrors"]</div>
    }
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    @{
        var pre = ViewData["PreselectedDestinationId"] as int?;
        var items = ViewBag.DestinationId as System.Collections.Generic.IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    }
    <div class="form-group">
        <label asp-for="DestinationId">Destination</label>
        @if (pre != null && pre > 0)
        {
            <input type="hidden" asp-for="DestinationId" value="@pre" />
            var selectedName = items?.FirstOrDefault(i => i.Value == pre.ToString())?.Text ?? "";
            <input class="form-control" value="@selectedName" readonly />
        }
        else
        {
            <select asp-for="DestinationId" class="form-control" asp-items="ViewBag.DestinationId"></select>
        }
        <span asp-validation-for="DestinationId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Address"></label>
        <input asp-for="Address" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Phone"></label>
        <input asp-for="Phone" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Website"></label>
        <input asp-for="Website" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="PriceFrom">Başlangıç Fiyatı</label>
        <div class="input-group">
            <input asp-for="PriceFrom" class="form-control" />
            <span id="priceFromCurrencySuffix" class="input-group-text">TL</span>
        </div>
        <div class="mt-2">
            <label for="priceFromCurrencySelect" class="form-label">Para Türü</label>
            <select id="priceFromCurrencySelect" class="form-select">
                <option value="TL" selected>TL</option>
                <option value="USD">Dolar</option>
                <option value="SAR">Riyal</option>
                <option value="EUR">Euro</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="PriceTo">Üst Fiyat</label>
        <div class="input-group">
            <input asp-for="PriceTo" class="form-control" />
            <span id="priceToCurrencySuffix" class="input-group-text">TL</span>
        </div>
        <div class="mt-2">
            <label for="priceToCurrencySelect" class="form-label">Para Türü</label>
            <select id="priceToCurrencySelect" class="form-select">
                <option value="TL" selected>TL</option>
                <option value="USD">Dolar</option>
                <option value="SAR">Riyal</option>
                <option value="EUR">Euro</option>
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const priceFromCurrencySelect = document.getElementById('priceFromCurrencySelect');
            const priceFromCurrencySuffix = document.getElementById('priceFromCurrencySuffix');
            const priceToCurrencySelect = document.getElementById('priceToCurrencySelect');
            const priceToCurrencySuffix = document.getElementById('priceToCurrencySuffix');

            function updateSuffix(selectEl, suffixEl) {
                if (!selectEl || !suffixEl) return;
                suffixEl.textContent = selectEl.value;
            }

            if (priceFromCurrencySelect && priceFromCurrencySuffix) {
                priceFromCurrencySelect.addEventListener('change', function () {
                    updateSuffix(priceFromCurrencySelect, priceFromCurrencySuffix);
                });
                updateSuffix(priceFromCurrencySelect, priceFromCurrencySuffix);
            }

            if (priceToCurrencySelect && priceToCurrencySuffix) {
                priceToCurrencySelect.addEventListener('change', function () {
                    updateSuffix(priceToCurrencySelect, priceToCurrencySuffix);
                });
                updateSuffix(priceToCurrencySelect, priceToCurrencySuffix);
            }
        })();
    </script>
}
