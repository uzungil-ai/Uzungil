@model Roma.Models.DestinationImage

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>DestinationImage</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Url</dt>
        <dd class="col-sm-10">@Model.Url</dd>

        <dt class="col-sm-2">Destination</dt>
        <dd class="col-sm-10">@Model.Destination?.Name</dd>

        <dt class="col-sm-2">Order</dt>
        <dd class="col-sm-10">@Model.Order</dd>

        <dt class="col-sm-2">AltText</dt>
        <dd class="col-sm-10">@Model.AltText</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
