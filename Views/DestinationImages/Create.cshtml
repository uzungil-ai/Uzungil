@model Roma.Models.DestinationImage

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>DestinationImage</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label asp-for="Url" class="control-label"></label>
                <input asp-for="Url" class="form-control" />
                <span asp-validation-for="Url" class="text-danger"></span>
            </div>
            @{
                var pre = ViewData["PreselectedDestinationId"] as int?;
                var items = ViewBag.DestinationId as System.Collections.Generic.IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
            }
            <div class="form-group">
                <label asp-for="DestinationId" class="control-label">Destination</label>
                @if (pre != null && pre > 0)
                {
                    <input type="hidden" asp-for="DestinationId" value="@pre" />
                    var selectedName = items?.FirstOrDefault(i => i.Value == pre.ToString())?.Text ?? "";
                    <input class="form-control" value="@selectedName" readonly />
                }
                else
                {
                    <select asp-for="DestinationId" class="form-control" asp-items="ViewBag.DestinationId"></select>
                }
                <span asp-validation-for="DestinationId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Order" class="control-label"></label>
                <input asp-for="Order" class="form-control" />
                <span asp-validation-for="Order" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AltText" class="control-label"></label>
                <input asp-for="AltText" class="form-control" />
                <span asp-validation-for="AltText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>
