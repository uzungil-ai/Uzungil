@{
    ViewData["Title"] = "Home Page";
}

<!--
  Geliştirici notları (view-source ile görünür):
  - Admin alanı (MVC): /Admin/DestinationImages
  - Admin Razor Pages: /Admin/Destinations
  - Fotoğrafları yönet: /Destinations/ManagePhotos?id={destinationId}
  - Yüklenen dosyalar fiziksel olarak: wwwroot/uploads/destinations/{id}/
  - Görseller detay sayfasında veya Views/Destinations/Details.cshtml içinde otomatik olarak gösterilir.
-->

<div class="text-center">
    <h1 class="display-4">Roma</h1>
    <p class="lead">Hızlı linkler ve geliştirme notları aşağıda.</p>

    <div class="mt-4">
        <a class="btn btn-primary me-2" asp-controller="Destinations" asp-action="Index">Destinations</a>
        <a class="btn btn-secondary me-2" asp-controller="Hotels" asp-action="Index">Hotels</a>
        <a class="btn btn-info me-2" asp-controller="DestinationImages" asp-action="Index">All Images</a>
        <a class="btn btn-outline-primary" href="/Destinations/ManagePhotos">Manage Photos</a>
    </div>

    <div class="mt-4 text-start mx-auto" style="max-width:760px">
        <h5>Kısa Açıklamalar</h5>
        <ul>
            <li>Fotoğraflar <code>/uploads/destinations/{id}/</code> altında saklanır.</li>
            <li>Admin yetkisi ile giriş yaparsanız <em>Yönetim</em> menüsünden resimleri yönetebilirsiniz.</li>
            <li>Bir destinasyonun fotoğraflarını görüntülemek için Destinations detay sayfasını kullanın.</li>
        </ul>
    </div>
</div>
