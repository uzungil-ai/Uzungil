@{
    ViewData["Title"] = "Site Hakkında";
}

<br />
<br />

<section class="about-hero-section mb-3">
    <div class="card shadow-sm border-0 about-hero-card">
        <div class="card-body p-4 p-md-5">
            <div class="about-hero-badge mb-2">Fotografia</div>
            <h1 class="h3 h2-md mb-2">Seyahati keşfetmenin en pratik yolu</h1>
            <p class="mb-3 text-muted">Destinasyon içerikleri, yapay zekâ destekli arama ve güncel öneriler tek bir deneyimde birleşir.</p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-sm">Ana Sayfa</a>
                <a asp-controller="Home" asp-action="Ekibimiz" class="btn btn-outline-primary btn-sm">Ekibimiz</a>
                <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-secondary btn-sm">Gizlilik</a>
                <a href="#site-ozellikleri" class="btn btn-outline-dark btn-sm">Site Özellikleri</a>
            </div>
        </div>
    </div>
</section>

<section class="about-page-section" id="hakkinda-detay">
    <div class="row g-3 align-items-stretch">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0 about-detail-jumbotron h-100">
                <div class="row g-0 align-items-stretch h-100">
                    <div class="col-12 col-md-5">
                        <div class="about-image-wrap about-detail-image-wrap">
                            <img src="/ekip/recep.webp" alt="Hakkında" class="about-image" />
                        </div>
                    </div>
                    <div class="col-12 col-md-7">
                        <div class="card-body about-card-body about-detail-body">
                            <h4 class="about-page-title">@ViewData["Title"]</h4>
                            <p>Fotografia, sitesinde yurt içinde ve yurt dışındaki destinasyon bilgileri yer almaktadır.</p>
                            <p>Site üzerinden yer alan Chat-Bot ve OpenAI-Chat ile arama yapabilirsiniz.</p>
                            <p>Ayrıca e-posta adresinizle abone olarak yeni destinasyonlar, içerik güncellemelerini alabilirsiniz.</p>
                            <p>Fotografia’nın amacı, ilham veren içerikleri sade bir deneyimle birleştirerek herkes için
                                erişilebilir bir seyahat rehberi sunmaktır.
                            </p>
                            <p>Fotografia’nın tüm hakları Recep Uzungil'e aittir.</p>
                            <div class="about-social-block about-detail-social mt-3" aria-label="Sosyal medya bağlantıları" id="sosyal-medya">
                                <h5 class="h6 mb-2">Sosyal Medya</h5>
                                <div class="social-links">
                                    <a href="https://www.linkedin.com/in/recep-uzungil-477a2935?originalSubdomain=tr/" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8.2A1.7 1.7 0 1 1 6.5 4.8a1.7 1.7 0 0 1 0 3.4ZM5 10h3v9H5v-9Zm5 0h2.9v1.3h.1c.4-.8 1.4-1.6 2.9-1.6 3.1 0 3.7 2 3.7 4.7V19h-3v-4c0-.9 0-2.1-1.3-2.1s-1.5 1-1.5 2V19h-3v-9Z" /></svg>
                                    </a>
                                    <a href="https://www.instagram.com/recepuzungil/" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 1.8A3.7 3.7 0 0 0 3.8 7.5v9a3.7 3.7 0 0 0 3.7 3.7h9a3.7 3.7 0 0 0 3.7-3.7v-9a3.7 3.7 0 0 0-3.7-3.7h-9Zm9.35 1.35a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.8A3.2 3.2 0 1 0 12 15.2 3.2 3.2 0 0 0 12 8.8Z" /></svg>
                                    </a>
                                    <a href="https://youtube.com" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 8.2a3 3 0 0 0-2.1-2.1C19 5.5 12 5.5 12 5.5s-7 0-8.9.6A3 3 0 0 0 1 8.2 31.2 31.2 0 0 0 .5 12a31.2 31.2 0 0 0 .5 3.8 3 3 0 0 0 2.1 2.1c1.9.6 8.9.6 8.9.6s7 0 8.9-.6a3 3 0 0 0 2.1-2.1 31.2 31.2 0 0 0 .5-3.8 31.2 31.2 0 0 0-.5-3.8ZM10 15.1V8.9L15.5 12 10 15.1Z" /></svg>
                                    </a>
                                    <a href="https://x.com/UzungilRecep" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="X">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.7L23 22h-6.2l-4.9-6.5L6.2 22H3l7.3-8.3L1 2h6.3l4.4 5.9L18.9 2Zm-1.1 18h1.7L6.4 3.9H4.6L17.8 20Z" /></svg>
                                    </a>
                                    <a href="https://www.facebook.com/recep.uzungil" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.5 1.6-1.5h1.7V4.9a23 23 0 0 0-2.4-.1c-2.4 0-4 1.4-4 4.1V11H8v3h2.4v8h3.1Z" /></svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="d-flex flex-column gap-3 h-100 justify-content-start">
                <div class="quick-stat-box text-center about-summary-stat">
                    <div class="small text-muted">Destinasyon Sayısı</div>
                    <div class="h4 mb-1">@ViewBag.TotalDestinationCount</div>
                </div>
                <div class="quick-stat-box text-center about-summary-stat">
                    <div class="small text-muted">Fotograf Sayısı</div>
                    <div class="h4 mb-1">@ViewBag.TotalPhotoCount</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="about-page-section" id="site-ozellikleri">
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
            <a asp-page="/OpenAiSoruCevap/Index" class="quick-stat-box text-center h-100 d-block text-decoration-none" aria-label="OpenAI soru cevap sayfasına git">
                <div class="small text-muted">Akıllı Deneyim</div>
                <div class="h4 mb-1">AI Destekli</div>
                <div class="h6 mb-0">Chat-Bot + OpenAI Soru-Cevap</div>
            </a>
        </div>
        <div class="col-12 col-md-4">
            <a asp-controller="Home" asp-action="Index" class="quick-stat-box text-center h-100 d-block text-decoration-none" aria-label="Ana sayfaya git">
                <div class="small text-muted">İçerik Kapsamı</div>
                <div class="h4 mb-1">Global</div>
                <div class="h6 mb-0">Yurt içi ve yurt dışı rotalar</div>
            </a>
        </div>
        <div class="col-12 col-md-4">
            <a asp-page="/Subscribe" class="quick-stat-box text-center h-100 d-block text-decoration-none" aria-label="Abonelik sayfasına git">
                <div class="small text-muted">Güncel Bildirim</div>
                <div class="h4 mb-1">E-Posta</div>
                <div class="h6 mb-0">Yeni içerikleri anında takip edin</div>
            </a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <article class="feature-box feature-step-card h-100">
                <div class="feature-step-icon"><i class="bi bi-stars"></i></div>
                <h3 class="h5">Kişiselleştirilmiş Keşif</h3>
                <p class="text-muted mb-0">Ziyaretçilere ilham veren destinasyonları hızlı, sade ve etkileyici bir akışla sunar.</p>
            </article>
        </div>
        <div class="col-12 col-lg-4">
            <article class="feature-box feature-step-card h-100">
                <div class="feature-step-icon"><i class="bi bi-lightning-charge"></i></div>
                <h3 class="h5">Hızlı Erişim</h3>
                <p class="text-muted mb-0">Arama, filtreleme ve içerik gezinme adımları minimum eforla maksimum bilgiye ulaşmayı hedefler.</p>
            </article>
        </div>
        <div class="col-12 col-lg-4">
            <article class="feature-box feature-step-card h-100">
                <div class="feature-step-icon"><i class="bi bi-shield-check"></i></div>
                <h3 class="h5">Güvenli ve Sürdürülebilir</h3>
                <p class="text-muted mb-0">Modern altyapı, düzenli içerik güncellemeleri ve kullanıcı odaklı yaklaşım ile sürekli gelişir.</p>
            </article>
        </div>
    </div>
</section>
