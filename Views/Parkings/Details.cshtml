@model Roma.Models.Parking

@{
    ViewData["Title"] = "Otopark Detayı";
}

<h1>Otopark Detayı</h1>

<div>
    <h4>@Model.Name</h4>
    <dl class="row">
        <dt class="col-sm-2">Destinasyon</dt>
        <dd class="col-sm-10">@Model.Destination?.Name</dd>

        <dt class="col-sm-2">Kapasite</dt>
        <dd class="col-sm-10">@Model.Capacity</dd>

        <dt class="col-sm-2">Ücretli mi?</dt>
        <dd class="col-sm-10">@Model.IsPaid</dd>

        <dt class="col-sm-2">Sabit Ücret</dt>
        <dd class="col-sm-10">@(Model.Fee.HasValue ? $"{Model.Fee.Value:0.##} TL" : "-")</dd>

        <dt class="col-sm-2">Saatlik Ücret</dt>
        <dd class="col-sm-10">@(Model.HourlyRate.HasValue ? $"{Model.HourlyRate.Value:0.##} TL" : "-")</dd>
    </dl>
</div>

<p>
    <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-success" asp-action="Create" asp-route-destinationId="@Model.DestinationId">New Parking</a>
    <a class="btn btn-primary" asp-action="Index">Back to List</a>
</p>