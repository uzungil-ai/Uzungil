@model Roma.Models.Parking

@{
    ViewData["Title"] = "Parking Details";
}

<h1>Parking Details</h1>

<div>
    <h4>@Model.Name</h4>
    <dl class="row">
        <dt class="col-sm-2">Destination</dt>
        <dd class="col-sm-10">@Model.Destination?.Name</dd>

        <dt class="col-sm-2">Capacity</dt>
        <dd class="col-sm-10">@Model.Capacity</dd>

        <dt class="col-sm-2">Is Paid</dt>
        <dd class="col-sm-10">@Model.IsPaid</dd>

        <dt class="col-sm-2">Fee</dt>
        <dd class="col-sm-10">@Model.Fee</dd>

        <dt class="col-sm-2">Hourly Rate</dt>
        <dd class="col-sm-10">@Model.HourlyRate</dd>
    </dl>
</div>

<p>
    <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-success" asp-action="Create" asp-route-destinationId="@Model.DestinationId">New Parking</a>
    <a class="btn btn-primary" asp-action="Index">Back to List</a>
</p>