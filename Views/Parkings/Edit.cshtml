@model Roma.Models.Parking

@{
    ViewData["Title"] = "Edit Parking";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h1 class="h5 mb-0">Edit Parking</h1>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DestinationId">Destination</label>
                        <select asp-for="DestinationId" class="form-control" asp-items="ViewBag.DestinationId"></select>
                        <span asp-validation-for="DestinationId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Capacity"></label>
                        <input asp-for="Capacity" class="form-control" />
                        <span asp-validation-for="Capacity" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="IsPaid" class="form-check-input" />
                        <label asp-for="IsPaid" class="form-check-label"></label>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Fee">Sabit Ücret</label>
                        <div class="input-group">
                            <input asp-for="Fee" class="form-control" />
                            <span id="feeCurrencySuffix" class="input-group-text">TL</span>
                        </div>
                        <div class="mt-2">
                            <label for="feeCurrencySelect" class="form-label">Para Türü</label>
                            <select id="feeCurrencySelect" class="form-select">
                                <option value="TL" selected>TL</option>
                                <option value="USD">Dolar</option>
                                <option value="SAR">Riyal</option>
                                <option value="EUR">Euro</option>
                            </select>
                        </div>
                        <span asp-validation-for="Fee" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HourlyRate">Saatlik Ücret</label>
                        <div class="input-group">
                            <input asp-for="HourlyRate" class="form-control" />
                            <span id="hourlyCurrencySuffix" class="input-group-text">TL</span>
                        </div>
                        <div class="mt-2">
                            <label for="hourlyCurrencySelect" class="form-label">Para Türü</label>
                            <select id="hourlyCurrencySelect" class="form-select">
                                <option value="TL" selected>TL</option>
                                <option value="USD">Dolar</option>
                                <option value="SAR">Riyal</option>
                                <option value="EUR">Euro</option>
                            </select>
                        </div>
                        <span asp-validation-for="HourlyRate" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark">Save</button>
                        <a asp-action="Index" class="btn btn-outline-dark">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const feeCurrencySelect = document.getElementById('feeCurrencySelect');
            const feeCurrencySuffix = document.getElementById('feeCurrencySuffix');
            const hourlyCurrencySelect = document.getElementById('hourlyCurrencySelect');
            const hourlyCurrencySuffix = document.getElementById('hourlyCurrencySuffix');

            function updateSuffix(selectEl, suffixEl) {
                if (!selectEl || !suffixEl) return;
                suffixEl.textContent = selectEl.value;
            }

            if (feeCurrencySelect && feeCurrencySuffix) {
                feeCurrencySelect.addEventListener('change', function () {
                    updateSuffix(feeCurrencySelect, feeCurrencySuffix);
                });
                updateSuffix(feeCurrencySelect, feeCurrencySuffix);
            }

            if (hourlyCurrencySelect && hourlyCurrencySuffix) {
                hourlyCurrencySelect.addEventListener('change', function () {
                    updateSuffix(hourlyCurrencySelect, hourlyCurrencySuffix);
                });
                updateSuffix(hourlyCurrencySelect, hourlyCurrencySuffix);
            }
        })();
    </script>
}