@model Roma.Models.Attraction

@{
    ViewData["Title"] = "Delete";
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div class="hover-blue-shadow p-3 rounded-3">
    <h4>Attraction</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Model.Category</dd>

        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@Model.Address</dd>

        <dt class="col-sm-2">Destination</dt>
        <dd class="col-sm-10">@Model.Destination?.Name</dd>
    </dl>

    <form asp-action="Delete" method="post" class="hover-blue-shadow p-3 rounded-3">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger hover-blue-shadow" />
        <a class="btn btn-secondary hover-blue-shadow" asp-action="Index">Back to List</a>
        @if (isAuthenticated)
        {
            <a class="btn btn-outline-secondary hover-blue-shadow" href="javascript:history.back()">Önceki Sayfaya Dön</a>
        }
    </form>
</div>
