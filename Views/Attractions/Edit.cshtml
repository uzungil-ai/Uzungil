@model Roma.Models.Attraction

@{
    ViewData["Title"] = "Edit";
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h1 class="h5 mb-0">Edit Attraction</h1>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Category" class="control-label"></label>
        <input asp-for="Category" class="form-control" />
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Address" class="control-label"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AverageRating" class="control-label"></label>
        <input asp-for="AverageRating" class="form-control" type="number" min="1" max="5" step="0.1" />
        <small class="form-text text-muted">1.0 - 5.0 arası giriniz.</small>
        <span asp-validation-for="AverageRating" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DestinationId" class="control-label"></label>
        <select asp-for="DestinationId" class="form-control" asp-items="ViewBag.DestinationId"></select>
        <span asp-validation-for="DestinationId" class="text-danger"></span>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3">
        <input type="submit" value="Save" class="btn btn-dark" />
        <a class="btn btn-outline-dark" asp-action="Index">Back to List</a>
        @if (isAuthenticated)
        {
            <a class="btn btn-outline-dark" href="javascript:history.back()">Önceki Sayfaya Dön</a>
        }
    </div>
</form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
