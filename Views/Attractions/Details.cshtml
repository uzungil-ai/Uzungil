@model Roma.Models.Attraction

@{
    ViewData["Title"] = "Cazibe Noktası Detayı";
    var canManage = User?.Identity?.IsAuthenticated == true;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="mb-0">@Model.Name</h2>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Ana Sayfaya Dön</a>
        <a class="btn btn-outline-secondary" href="javascript:history.back()">Önceki Sayfaya Dön</a>
        <a class="btn btn-secondary" asp-action="Index">Listeye Dön</a>
        @if (canManage)
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a>
            <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.Id">Sil</a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="card mb-4 shadow-sm destination-card border-0">
    <div class="card-header"><strong>Cazibe Noktası Bilgisi</strong></div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Ad</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            @* <dt class="col-sm-3">Kategori</dt>
            <dd class="col-sm-9">@Model.Category</dd> *@

            <dt class="col-sm-3">Adres</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.Address))
                {
                    var addressUrl = Model.Address.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                                     Model.Address.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
                        ? Model.Address
                        : $"https://{Model.Address}";

                    <a href="@addressUrl" target="_blank" rel="noopener noreferrer" title="Adres bağlantısını aç">
                        <span class="text-decoration-underline">Bağlantıyı Aç</span>
                    </a>
                }
                else
                {
                    <span>-</span>
                }
            </dd>

            <dt class="col-sm-3">Destinasyon</dt>
            <dd class="col-sm-9">@Model.Destination?.Name</dd>

            <dt class="col-sm-3">Ortalama Puan</dt>
            <dd class="col-sm-9">
                @Html.RatingBadge(Model.AverageRating)
            </dd>
        </dl>
    </div>
</div>
