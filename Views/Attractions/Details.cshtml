@model Roma.Models.Attraction

@{
    ViewData["Title"] = "Details";
}

@* <h1>Details</h1> *@

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div>
   @*  <h4>Attraction</h4> *@
    <hr />
    <dl class="row">
       @*  <dt class="col-sm-2">Name</dt> *@
        <dd class="col-sm-10">@Model.Name</dd>

        @* <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Model.Category</dd> *@

      @*   <dt class="col-sm-2">Address</dt> *@
        <dd class="col-sm-10">
            @if (!string.IsNullOrWhiteSpace(Model.Address))
            {
                var addressUrl = Model.Address.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                                 Model.Address.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
                    ? Model.Address
                    : $"https://{Model.Address}";

                <a href="@addressUrl" target="_blank" rel="noopener noreferrer" title="Adres bağlantısını aç">
                    <span class="text-decoration-underline">Bağlantı</span>
                </a>
            }
            else
            {
                <span>-</span>
            }
        </dd>

        <dt class="col-sm-2">Destination</dt>
       @*  <dd class="col-sm-10">@Model.Destination?.Name</dd> *@

        @* <dt class="col-sm-2">Average Rating</dt>
        <dd class="col-sm-10">
            @Html.RatingBadge(Model.AverageRating)
        </dd> *@
    </dl>
</div>

