@model Roma.Models.Attraction

@{
    ViewData["Title"] = "Cazibe Noktası Detayı";
    var mapUrl = !string.IsNullOrWhiteSpace(Model.Address)
        ? (Model.Address.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
           Model.Address.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            ? Model.Address
            : $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(Model.Address)}")
        : null;
}

<br />

<div class="row justify-content-center">
    <div class="col-12 col-md-6">
        <div class="card mb-4 shadow-sm destination-card border-0">
            <div class="card-body">
                <h2 class="mb-3">@Model.Name</h2>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }

                <div class="card shadow-sm destination-card border-0">
                    <div class="card-header"><strong>Cazibe Noktası Bilgisi</strong></div>
                    <div class="card-body">
                        <div class="mb-2">@Model.Name</div>
                        <div class="mb-2">
                            @if (!string.IsNullOrWhiteSpace(Model.Address))
                            {
                                var addressUrl = Model.Address.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                                                 Model.Address.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
                                    ? Model.Address
                                    : $"https://{Model.Address}";

                                <a class="btn btn-sm btn-navbar-theme" href="@addressUrl" target="_blank" rel="noopener noreferrer" title="Adres bağlantısını aç">
                                    Bağlantıyı Aç
                                </a>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </div>
                        <div class="mb-2">@Model.Destination?.Name</div>
                        <div>@Html.RatingBadge(Model.AverageRating)</div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    @if (!string.IsNullOrWhiteSpace(mapUrl))
                    {
                        <a class="btn btn-success" href="@mapUrl" target="_blank" rel="noopener noreferrer" title="Google Haritalar'da aç" aria-label="Google Haritalar'da aç">Git</a>
                    }
                    <a class="btn btn-primary" asp-controller="Reviews" asp-action="Create" asp-route-attractionId="@Model.Id">Yorum Ekle</a>
    <a class="btn btn-soft-yellow-action" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
    <a class="btn btn-soft-yellow-action" href="javascript:history.back()">Geri</a>
                </div>
            </div>
        </div>
    </div>
</div>
