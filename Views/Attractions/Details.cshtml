@model Roma.Models.Attraction

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Attraction</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Model.Category</dd>

        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@Model.Address</dd>

        <dt class="col-sm-2">Destination</dt>
        <dd class="col-sm-10">@Model.Destination?.Name</dd>

        <dt class="col-sm-2">Average Rating</dt>
        <dd class="col-sm-10">@Model.AverageRating</dd>
    </dl>
</div>

<div class="mb-4">
    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
</div>

@if (Model.Reviews != null && Model.Reviews.Count > 0)
{
    <h4>Reviews (@Model.Reviews.Count)</h4>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Comment</th>
                <th>Rating</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
        @foreach(var r in Model.Reviews)
        {
            <tr>
                <td>@r.Comment</td>
                <td>@r.Rating</td>
                <td>@r.CreatedAt</td>
            </tr>
        }
        </tbody>
    </table>
}
