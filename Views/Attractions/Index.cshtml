@model IEnumerable<Roma.Models.Attraction>

@{
    ViewData["Title"] = "Attractions";
    var canManage = User?.Identity?.IsAuthenticated == true;
}

<h3 class="attractions-title">Gezilecek Yerler</h3>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (canManage)
{
    <p>
        <a class="btn btn-primary hover-blue-shadow" asp-action="Create">Create New</a>
    </p>
}

@if (Model.Any())
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm hover-blue-shadow">
                    <div class="card-body">
                        <h5 class="card-title mb-2">@item.Name</h5>
                        <div class="small text-muted mb-1">Kategori: @item.Category</div>
                        <div class="small text-muted mb-1">Destinasyon: @(item.Destination?.Name ?? "-")</div>
                        <div>@Html.RatingBadge(item.AverageRating)</div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0 d-flex gap-2 flex-wrap">
                        @if (!string.IsNullOrWhiteSpace(item.Address))
                        {
                            var addressUrl = item.Address.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                                             item.Address.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
                                ? item.Address
                                : $"https://{item.Address}";

                            <a class="btn btn-sm btn-info hover-blue-shadow" href="@addressUrl" target="_blank" rel="noopener noreferrer">Detay</a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-info" disabled>Detay</button>
                        }
                        @if (canManage)
                        {
                            <a class="btn btn-sm btn-secondary hover-blue-shadow" asp-action="Edit" asp-route-id="@item.Id">Düzenle</a>
                            <a class="btn btn-sm btn-danger hover-blue-shadow" asp-action="Delete" asp-route-id="@item.Id">Sil</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-muted">Henüz kayıtlı attraction yok.</div>
}
