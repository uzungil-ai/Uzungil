@model Roma.Models.Meal

@{
    ViewData["Title"] = "Create Meal";
}

<h1>Create Meal</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    @if (TempData["ModelErrors"] != null)
    {
        <div class="alert alert-danger">@TempData["ModelErrors"]</div>
    }
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Address"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Phone"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Price">Fiyat</label>
        <div class="input-group">
            <input asp-for="Price" class="form-control" />
            <span id="priceCurrencySuffix" class="input-group-text">TL</span>
        </div>
        <div class="mt-2">
            <label for="priceCurrencySelect" class="form-label">Para Türü</label>
            <select id="priceCurrencySelect" class="form-select">
                <option value="TL" selected>TL</option>
                <option value="USD">Dolar</option>
                <option value="SAR">Riyal</option>
                <option value="EUR">Euro</option>
            </select>
        </div>
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    @{
        var pre = ViewData["PreselectedDestinationId"] as int?;
        var items = ViewData["DestinationId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
        var listItems = items?.Items as System.Collections.Generic.IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    }
    <div class="form-group">
        <label asp-for="DestinationId">Destination</label>
        @if (pre != null && pre > 0)
        {
            <input type="hidden" asp-for="DestinationId" value="@pre" />
            var selectedName = listItems?.FirstOrDefault(i => i.Value == pre.ToString())?.Text ?? "";
            <input class="form-control" value="@selectedName" readonly />
        }
        else
        {
            <select asp-for="DestinationId" asp-items="@(ViewData["DestinationId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-control"></select>
        }
        <span asp-validation-for="DestinationId" class="text-danger"></span>
    </div>
    <div class="form-group mt-2">
        <input type="submit" value="Create" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const priceCurrencySelect = document.getElementById('priceCurrencySelect');
            const priceCurrencySuffix = document.getElementById('priceCurrencySuffix');

            function updateSuffix() {
                if (!priceCurrencySelect || !priceCurrencySuffix) return;
                priceCurrencySuffix.textContent = priceCurrencySelect.value;
            }

            if (priceCurrencySelect && priceCurrencySuffix) {
                priceCurrencySelect.addEventListener('change', updateSuffix);
                updateSuffix();
            }
        })();
    </script>
}
