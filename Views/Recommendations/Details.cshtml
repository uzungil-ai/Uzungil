@model Roma.Models.Recommendation

@{
    ViewData["Title"] = "Recommendation Details";
}

<h1>Recommendation Details</h1>

<div>
    <h4>@Model.Title</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Destination</dt>
        <dd class="col-sm-10">@Model.Destination?.Name</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Url</dt>
        <dd class="col-sm-10">@Model.Url</dd>

        <dt class="col-sm-2">User Id</dt>
        <dd class="col-sm-10">@Model.UserId</dd>

        <dt class="col-sm-2">Official</dt>
        <dd class="col-sm-10">@Model.IsOfficial</dd>

        <dt class="col-sm-2">Created At</dt>
        <dd class="col-sm-10">@Model.CreatedAt</dd>
    </dl>
</div>

<p>
    <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-primary" asp-action="Index">Back to List</a>
</p>