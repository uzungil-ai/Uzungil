@model IEnumerable<Roma.Models.Recommendation>

@{
    ViewData["Title"] = "Recommendations";
}

<h1>Recommendations</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Destination</th>
            <th>Url</th>
            <th>Official</th>
            <th>Created At</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Destination?.Name</td>
            <td>@item.Url</td>
            <td>@item.IsOfficial</td>
            <td>@item.CreatedAt</td>
            <td>
                <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.Id">Details</a>
                <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>