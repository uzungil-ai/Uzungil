@model Roma.Models.Recommendation

@{
    ViewData["Title"] = "Create Recommendation";
}

<h1>Create Recommendation</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Url"></label>
        <input asp-for="Url" class="form-control" />
        <span asp-validation-for="Url" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="UserId"></label>
        <input asp-for="UserId" class="form-control" />
        <span asp-validation-for="UserId" class="text-danger"></span>
    </div>
    @{
        var pre = ViewData["PreselectedDestinationId"] as int?;
        var items = ViewData["DestinationId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
        var listItems = items?.Items as System.Collections.Generic.IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    }
    <div class="form-group">
        <label asp-for="DestinationId">Destination</label>
        @if (pre != null && pre > 0)
        {
            <input type="hidden" asp-for="DestinationId" value="@pre" />
            var selectedName = listItems?.FirstOrDefault(i => i.Value == pre.ToString())?.Text ?? "";
            <input class="form-control" value="@selectedName" readonly />
        }
        else
        {
            <select asp-for="DestinationId" asp-items="@(ViewData["DestinationId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-control"></select>
        }
        <span asp-validation-for="DestinationId" class="text-danger"></span>
    </div>
    <div class="form-group form-check mt-2">
        <input asp-for="IsOfficial" class="form-check-input" />
        <label asp-for="IsOfficial" class="form-check-label"></label>
    </div>
    <div class="form-group mt-2">
        <input type="submit" value="Create" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}