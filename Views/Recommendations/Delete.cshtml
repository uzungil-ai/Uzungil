@model Roma.Models.Recommendation

@{
    ViewData["Title"] = "Delete Recommendation";
}

<h1>Delete Recommendation</h1>

<h4>Are you sure you want to delete this?</h4>
<div>
    <h4>@Model.Title</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Destination</dt>
        <dd class="col-sm-10">@Model.Destination?.Name</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Url</dt>
        <dd class="col-sm-10">@Model.Url</dd>

        <dt class="col-sm-2">Official</dt>
        <dd class="col-sm-10">@Model.IsOfficial</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group mt-2">
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</form>