@model IEnumerable<Roma.Models.Destination>

@{
    ViewData["Title"] = "Destinasyonlar";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-0">Destinasyonlar</h1>
        <small class="text-muted">Toplam: @(Model?.Count() ?? 0)</small>
    </div>
    <a class="btn btn-primary" asp-action="Create">Yeni Destinasyon</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">Henüz destinasyon bulunmuyor.</div>
}
else
{
    <div class="row g-3">
    @foreach (var item in Model)
    {
        var coverImage = item.Images?
            .OrderBy(i => i.Order)
            .ThenBy(i => i.Id)
            .FirstOrDefault();

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-200 shadow-sm">
                @if (coverImage != null && !string.IsNullOrWhiteSpace(coverImage.Url))
                {
                    var imageUrl = coverImage.Url.StartsWith("/") ? coverImage.Url : "/" + coverImage.Url;
                        <img src="@Url.Content(imageUrl)" alt="@item.Name" style="height:100%;object-fit:cover;width:100%;" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light text-muted" style="height:180px;">
                        Görsel yok
                    </div>
                }

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title mb-1">@item.Name</h5>
                    <div class="text-muted mb-3">@item.Country</div>

                    <div class="small mb-3">
                        <div><strong>Görsel:</strong> @(item.Images?.Count ?? 0)</div>
                        <div><strong>Cazibe Noktası:</strong> @(item.Attractions?.Count ?? 0)</div>
                        <div><strong>Giriş Ücreti:</strong> @(item.EntranceFee.HasValue ? item.EntranceFee.Value.ToString("C") : "-")</div>
                    </div>

                    <div class="mt-auto d-flex flex-wrap gap-2">
                        <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.Id">Detay</a>
                        <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@item.Id">Düzenle</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Sil</a>
                        <a class="btn btn-sm btn-outline-secondary" href="/Destinations/ManagePhotos?id=@item.Id">Fotoğraflar</a>
                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <a class="btn btn-sm btn-outline-warning" href="/Admin/Uploads/Index?id=@item.Id" title="Upload images">Yükle</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
}
