@model Roma.Models.Destination

@{
    ViewData["Title"] = "Details";
}

@if (Model.Hotels != null && Model.Hotels.Count > 0)
{
    <h4>Hotels (@Model.Hotels.Count)</h4>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Name</th>
                <th>Address</th>
                <th>Phone</th>
                <th>Price From</th>
                <th>Price To</th>
            </tr>
        </thead>
        <tbody>
        @foreach(var h in Model.Hotels)
        {
            <tr>
                <td>@h.Name</td>
                <td>@h.Address</td>
                <td>@h.Phone</td>
                <td>@(h.PriceFrom.HasValue ? h.PriceFrom.Value.ToString("C") : "-")</td>
                <td>@(h.PriceTo.HasValue ? h.PriceTo.Value.ToString("C") : "-")</td>
            </tr>
        }
        </tbody>
    </table>
}

@if (Model.Meals != null && Model.Meals.Count > 0)
{
    <h4>Meals (@Model.Meals.Count)</h4>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Name</th>
                <th>Address</th>
                <th>Phone</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
        @foreach(var m in Model.Meals)
        {
            <tr>
                <td>@m.Name</td>
                <td>@m.Address</td>
                <td>@m.Phone</td>
                <td>@(m.Price.HasValue ? m.Price.Value.ToString("C") : "-")</td>
            </tr>
        }
        </tbody>
    </table>
}

<h1>Details</h1>

<div>
    <h4>Destination</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Country</dt>
        <dd class="col-sm-10">@Model.Country</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Entrance Fee</dt>
        <dd class="col-sm-10">@(Model.EntranceFee.HasValue ? Model.EntranceFee.Value.ToString("C") : "-")</dd>

        <dt class="col-sm-2">Instagram</dt>
        <dd class="col-sm-10">@Model.InstagramUrl</dd>

        <dt class="col-sm-2">Facebook</dt>
        <dd class="col-sm-10">@Model.FacebookUrl</dd>
    </dl>
</div>

<div class="mb-4">
    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-outline-secondary" href="/Destinations/ManagePhotos?id=@Model.Id">Manage Photos</a>
    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
    {
        <a class="btn btn-outline-warning ms-2" href="/Admin/Uploads/Index?id=@Model.Id" title="Upload images">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path fill-rule="evenodd" d="M8 12a.5.5 0 0 0 .5-.5V3.707l2.146 2.147a.5.5 0 0 0 .708-.708l-3-3a.498.498 0 0 0-.697.007l-3 3a.5.5 0 1 0 .708.708L7.5 3.707V11.5A.5.5 0 0 0 8 12z"/>
                <path d="M2.5 14a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1h-10a.5.5 0 0 1-.5-.5z"/>
            </svg>
            <span class="visually-hidden">Upload Images</span>
        </a>
    }
</div>

@if (Model.Images != null && Model.Images.Count > 0)
{
    <h4>Images</h4>
    <div class="d-flex flex-wrap mb-4">
        @foreach(var img in Model.Images.OrderBy(i => i.Order))
        {
            <div class="p-2">
                <img src="@img.Url" alt="@img.AltText" style="max-width:200px;max-height:150px;object-fit:cover;border:1px solid #ddd;padding:2px;" />
                <div class="small text-muted">@img.AltText</div>
            </div>
        }
    </div>
}

@if (Model.Attractions != null && Model.Attractions.Count > 0)
{
    <h4>Attractions (@Model.Attractions.Count)</h4>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Address</th>
                <th>Rating</th>
            </tr>
        </thead>
        <tbody>
        @foreach(var a in Model.Attractions)
        {
            <tr>
                <td>@a.Name</td>
                <td>@a.Category</td>
                <td>@a.Address</td>
                <td>@a.AverageRating</td>
            </tr>
        }
        </tbody>
    </table>
}
