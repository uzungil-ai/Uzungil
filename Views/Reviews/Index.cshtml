@model IEnumerable<Roma.Models.Review>

@{
    ViewData["Title"] = "Yorumlar";
    var isAdmin = User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin");
}

@functions {
    private static string MaskEmail(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return "-";
        }

        var parts = email.Split('@', 2);
        var localPart = parts[0];
        var domainPart = parts.Length > 1 ? parts[1] : string.Empty;

        if (localPart.Length == 1)
        {
            return $"{localPart[0]}*@{domainPart}";
        }

        var starCount = Math.Max(1, localPart.Length - 2);
        var maskedLocal = $"{localPart[0]}{new string('*', starCount)}{localPart[^1]}";

        return string.IsNullOrEmpty(domainPart) ? maskedLocal : $"{maskedLocal}@{domainPart}";
    }
}

<br />
<h4>Yorumlar</h4>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (isAdmin)
{
    <p>
        <a class="btn btn-primary" asp-action="Create">Yeni Yorum</a>
    </p>
}

<div class="mt-4">
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning">Bu sayfada gösterilecek onaylı yorum bulunmuyor.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex flex-nowrap align-items-center gap-3 mb-2 small overflow-auto">
                                <div class="fw-semibold text-nowrap">Destinasyon: @(item.Attraction?.Name ?? "Cazibe noktası belirtilmedi")</div>
                                <div>@Html.RatingBadge(item.Rating)</div>
                                <div class="text-muted text-nowrap">@item.CreatedAt</div>
                                <div class="text-nowrap"><strong>E-posta:</strong> @MaskEmail(item.User?.Email)</div>
                            </div>
                            <p class="card-text mb-3">@item.Comment</p>

                            @if (isAdmin)
                            {
                                <div class="d-flex gap-2 flex-wrap">
                                    <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.Id">Detay</a>
                                    <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@item.Id">Düzenle</a>
                                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Sil</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
