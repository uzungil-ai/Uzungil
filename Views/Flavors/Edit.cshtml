@model Roma.Models.Flavor

@{
    ViewData["Title"] = "Edit Flavor";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h1 class="h5 mb-0">Edit Flavor</h1>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DestinationId">Destination</label>
                        <select asp-for="DestinationId" asp-items="@(ViewData["DestinationId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-control"></select>
                        <span asp-validation-for="DestinationId" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <input type="submit" value="Save" class="btn btn-dark" />
                        <a asp-action="Index" class="btn btn-outline-dark">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
