@model Roma.Models.Flavor

@{
    ViewData["Title"] = "Edit Flavor";
}

<h1>Edit Flavor</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DestinationId">Destination</label>
        <select asp-for="DestinationId" asp-items="@(ViewData["DestinationId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-control"></select>
        <span asp-validation-for="DestinationId" class="text-danger"></span>
    </div>
    <div class="form-group mt-2">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
