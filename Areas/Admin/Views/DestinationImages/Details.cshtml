@model Roma.Models.DestinationImage

@{
    ViewData["Title"] = "Destination Image Details (Admin)";
}

<h1>Destination Image Details</h1>

<div>
    <h4>Image</h4>
    <dl class="row">
        <dt class="col-sm-2">Preview</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.Url))
            {
                <div class="card" style="max-width:420px;">
                    <img src="@Model.Url" alt="@(Model.AltText ?? "Destination image")" class="card-img-top" style="max-height:320px;object-fit:contain;" />
                    <div class="card-body p-2">
                        <div class="small text-muted">@(string.IsNullOrWhiteSpace(Model.AltText) ? "Alt text yok" : Model.AltText)</div>
                    </div>
                </div>
            }
        </dd>

        <dt class="col-sm-2">Destination</dt>
        <dd class="col-sm-10">@Model.Destination?.Name</dd>

        <dt class="col-sm-2">Order</dt>
        <dd class="col-sm-10">@Model.Order</dd>

        <dt class="col-sm-2">Alt Text</dt>
        <dd class="col-sm-10">@Model.AltText</dd>
    </dl>
</div>

<p>
    <a class="btn btn-secondary" asp-area="Admin" asp-action="Index">Back to List</a>
    <a class="btn btn-primary" asp-area="Admin" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
</p>
