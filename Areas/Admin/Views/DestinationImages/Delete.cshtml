@model Roma.Models.DestinationImage

@{
    ViewData["Title"] = "Delete Destination Image (Admin)";
}

<h1>Delete Destination Image</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>@Model.Url</h4>
    <dl class="row">
        <dt class="col-sm-2">Destination</dt>
        <dd class="col-sm-10">@Model.Destination?.Name</dd>

        <dt class="col-sm-2">Order</dt>
        <dd class="col-sm-10">@Model.Order</dd>
    </dl>
</div>

<form asp-area="Admin" asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-area="Admin" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
