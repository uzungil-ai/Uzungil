@page
@model Roma.Areas.Identity.Pages.Account.LoginWith2faModel
@{
    ViewData["Title"] = "İki Adımlı Doğrulama";
}

<h2>İki Adımlı Doğrulama</h2>
<p>Authenticator uygulamanızda görünen 6 haneli anlık kodu girin.</p>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-2">
        <label asp-for="Input.TwoFactorCode"></label>
        <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="one-time-code" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" />
        <span asp-validation-for="Input.TwoFactorCode" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Input.RememberMachine" class="form-check-input" />
        <label asp-for="Input.RememberMachine" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Doğrula</button>
</form>

<p class="mt-3">
    Authenticator cihazınıza erişemiyorsanız
    <a asp-area="Identity" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">recovery code ile giriş yapın</a>.
</p>
